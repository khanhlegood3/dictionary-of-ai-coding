+});
+
+test('shortAnswerOf đọc được cả ba kiểu §0, và không bỏ blockquote', async () => {
+  const { shortAnswerOf } = await import('../../scripts/extract_work_items.mjs');
+
+  // (a) đoạn văn
+  const para = shortAnswerOf('## 0. Trả lời ngắn\n\nĐây là một đoạn văn đủ dài để được nhận làm tóm tắt.\n\n## 1. X\n');
