+
+test('shortAnswerOf KHÔNG trả về dòng tiêu đề cột, và không cắt cụt câu trả lời', async () => {
+  const { shortAnswerOf } = await import('../../scripts/extract_work_items.mjs');
+
+  // Bảng có dòng tiêu đề `| # | Yêu cầu | Kết quả |` — bản vá trước in nguyên
