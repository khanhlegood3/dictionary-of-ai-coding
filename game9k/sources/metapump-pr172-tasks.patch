@@ -0,0 +1,525 @@
+/*
+ * tasks.css — bảng việc.
+ *
+ * Cố ý KHÔNG dùng lại app.css: trang này là một màn hình hẹp, một mục đích
+ * (nhà đầu tư mở ra thấy ngay việc còn tồn). Nhúng nó vào portal 7 tab sẽ kéo
+ * theo một đống CSS không dùng, và làm cả hai khó đọc hơn.
+ *
+ * Không có web font, không có ảnh nền, không thư viện ngoài — CSP của server chỉ
+ * cho 'self', nên mọi thứ ở đây phải tự đủ.
+ */
+
+:root {
+  --bg: #0b0f09;
+  --panel: #12180f;
+  --panel-2: #171f13;
+  --line: #24301c;
+  --line-2: #2f3d25;
+  --ink: #e8f0e0;
+  --ink-2: #a9b8a0;
+  --ink-3: #74856c;
+  --lime: #b8f24a;
+  --amber: #f2c14a;
+  --red: #f26a6a;
+  --blue: #6ab8f2;
+  --r: 12px;
+}
+
+* { box-sizing: border-box; }
+
+html, body {
+  margin: 0;
+  padding: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+
+a { color: var(--lime); text-decoration: none; }
+a:hover { text-decoration: underline; }
+
+.tw-shell { max-width: 1280px; margin: 0 auto; padding: 0 22px; }
+.tw-row { display: flex; align-items: center; gap: 14px; }
+.tw-spacer { flex: 1; }
+.tw-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em; }
+.tw-fine { color: var(--ink-3); font-size: 12.5px; line-height: 1.5; }
+
+/* ------------------------------------------------------------------ header */
+
+.tw-top {
+  border-bottom: 1px solid var(--line);
+  background: rgba(11, 15, 9, .92);
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  backdrop-filter: blur(8px);
+}
+.tw-top .tw-row { height: 62px; }
+
+.tw-brand { display: flex; align-items: center; gap: 11px; }
+.tw-mark {
+  width: 34px; height: 34px;
+  border-radius: 9px;
+  background: var(--lime);
+  color: #0a1405;
+  font-weight: 800;
+  display: grid; place-items: center;
+  font-family: ui-monospace, monospace;
+}
+.tw-brand-name { font-weight: 700; letter-spacing: .2px; }
+.tw-brand-sub { font-size: 11.5px; color: var(--ink-3); }
+
+.tw-links { display: flex; gap: 18px; font-size: 13px; }
+
+/* -------------------------------------------------------------------- hero */
+
+.tw-hero { padding: 38px 0 8px; }
+.tw-eyebrow {
+  font-size: 11.5px;
+  text-transform: uppercase;
+  letter-spacing: .1em;
+  color: var(--ink-3);
+  font-weight: 600;
+}
+.tw-hero h1 {
+  margin: 8px 0 10px;
+  font-size: clamp(26px, 3.4vw, 38px);
+  line-height: 1.15;
+  letter-spacing: -.02em;
+}
+.tw-lede { margin: 0; max-width: 78ch; color: var(--ink-2); font-size: 15px; }
+
+/* -------------------------------------------------------------------- kpis */
+
+.tw-kpis {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
+  gap: 12px;
+  margin: 26px 0 18px;
+}
+.tw-kpi {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r);
+  padding: 14px 15px;
+}
+.tw-kpi-label { font-size: 12px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .07em; }
+.tw-kpi-value { font-size: 27px; font-weight: 700; margin: 4px 0 2px; font-variant-numeric: tabular-nums; }
+.tw-kpi-foot { font-size: 12px; color: var(--ink-3); }
+
+/* ----------------------------------------------------------------- toolbar */
+
+.tw-toolbar {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  margin: 22px 0 16px;
+}
+.tw-toolbar input[type="search"], .tw-toolbar select {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  color: var(--ink);
+  border-radius: 9px;
+  padding: 9px 12px;
+  font: inherit;
+  font-size: 13.5px;
+  min-width: 150px;
+}
+.tw-toolbar input[type="search"] { min-width: 280px; flex: 1 1 280px; max-width: 420px; }
+.tw-toolbar input:focus, .tw-toolbar select:focus {
+  outline: 2px solid var(--lime);
+  outline-offset: 1px;
+}
+.tw-count { font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
+
+/* ------------------------------------------------------------------- board */
+
+.tw-board {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(240px, 1fr));
+  gap: 14px;
+  align-items: start;
+  padding-bottom: 10px;
+}
+@media (max-width: 1080px) {
+  .tw-board { grid-template-columns: repeat(2, minmax(240px, 1fr)); }
+}
+@media (max-width: 640px) {
+  .tw-board { grid-template-columns: 1fr; }
+  .tw-toolbar input[type="search"] { min-width: 0; }
+}
+
+.tw-col {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--r);
+  overflow: hidden;
+}
+.tw-col-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 11px 13px;
+  border-bottom: 1px solid var(--line);
+  background: var(--panel-2);
+}
+.tw-col-n {
+  font-size: 12px;
+  color: var(--ink-3);
+  font-variant-numeric: tabular-nums;
+}
+.tw-col-body {
+  padding: 10px;
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+  max-height: 62vh;
+  overflow-y: auto;
+}
+
+.tw-chip {
+  font-size: 11.5px;
+  font-weight: 600;
+  padding: 3px 9px;
+  border-radius: 999px;
+  border: 1px solid var(--line-2);
+  color: var(--ink-2);
+}
+.tw-chip.warn { color: var(--amber); border-color: #4a3d18; background: #221c0a; }
+.tw-chip.bad { color: var(--red); border-color: #4a2020; background: #230f0f; }
+.tw-chip.info { color: var(--blue); border-color: #1f3a4a; background: #0c1c24; }
+.tw-chip.muted { color: var(--ink-3); }
+
+/* -------------------------------------------------------------------- card */
+
+.tw-card {
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 11px 12px;
+  cursor: pointer;
+  transition: border-color .12s, transform .12s;
+}
+.tw-card:hover, .tw-card:focus-visible {
+  border-color: var(--line-2);
+  transform: translateY(-1px);
+  outline: none;
+}
+.tw-card:focus-visible { box-shadow: 0 0 0 2px var(--lime); }
+
+.tw-card-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-bottom: 6px;
+}
+.tw-code {
+  font-family: ui-monospace, monospace;
+  font-size: 11.5px;
+  color: var(--ink-3);
+}
+.tw-badge {
+  font-size: 10.5px;
+  padding: 1px 7px;
+  border-radius: 999px;
+  border: 1px solid var(--line-2);
+  color: var(--ink-3);
+}
+.tw-badge.warn { color: var(--amber); border-color: #4a3d18; }
+.tw-badge.ok { color: var(--lime); border-color: #33471c; }
+
+.tw-card-title {
+  font-weight: 600;
+  font-size: 13.5px;
+  line-height: 1.4;
+  margin-bottom: 4px;
+}
+.tw-card-body {
+  font-size: 12.5px;
+  color: var(--ink-2);
+  line-height: 1.45;
+  display: -webkit-box;
+  -webkit-line-clamp: 4;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.tw-card-foot { margin-top: 7px; }
+.tw-src { font-size: 11.5px; color: var(--ink-3); }
+.tw-src:hover { color: var(--lime); }
+
+.tw-empty {
+  padding: 16px 12px;
+  font-size: 12.5px;
+  color: var(--ink-3);
+  text-align: center;
+}
+
+/* ------------------------------------------------- thành phần kiểu Jira ---- */
+/*
+ * Mượn *bố cục* Jira, không mượn mã. Repo tham chiếu (`v0-jira-clone`) không có
+ * license ⇒ không một dòng CSS nào từ đó được dùng. Mọi thứ dưới đây viết mới,
+ * và dùng đúng các biến đã khai ở `:root` phía trên để bảng này giữ một bảng
+ * màu duy nhất với phần còn lại của trang.
+ */
+
+/* Gợi ý dưới tiêu đề cột — nói cột này là gì, không chỉ đếm số. */
+.tw-col-hint {
+  font-size: 11px;
+  color: var(--ink-3);
+  line-height: 1.4;
+  margin-top: 5px;
+  max-width: 26ch;
+}
+
+/*
+ * Nhãn ưu tiên dùng ĐÚNG bốn màu ngữ nghĩa của trang. Critical không được
+ * "đỏ hơn đỏ" — nó chỉ cần khác High đủ rõ, vì nhãn này xuất hiện dày trên thẻ
+ * và một hàng đỏ chói sẽ làm mất nhịp đọc.
+ */
+.tw-pri {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: .05em;
+  text-transform: uppercase;
+  padding: 2px 7px;
+  border-radius: 999px;
+  border: 1px solid var(--line-2);
+  color: var(--ink-3);
+  white-space: nowrap;
+}
+.tw-pri.crit { color: #fff; background: var(--red); border-color: var(--red); }
+.tw-pri.high { color: var(--red); border-color: #4a2020; background: #230f0f; }
+.tw-pri.med  { color: var(--amber); border-color: #4a3d18; background: #221c0a; }
+.tw-pri.low  { color: var(--ink-3); }
+
+/* Chân thẻ: số việc · avatar người quyết · link nguồn. */
+.tw-card-foot {
+  margin-top: 9px;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+}
+.tw-pt {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10.5px;
+  color: var(--ink-3);
+  border: 1px solid var(--line-2);
+  border-radius: 5px;
+  padding: 1px 6px;
+  white-space: nowrap;
+}
+.tw-assignee {
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 9px;
+  font-weight: 700;
+  color: #0a1405;
+  background: var(--lime);
+  border: 1px solid var(--line-2);
+  flex-shrink: 0;
+}
+/*
+ * Ô "?" là thông tin, không phải lỗi: 18 ADR viết trước mẫu 2026-11-18 không có
+ * dòng `**Người quyết:**`. Hiện nó bằng nét đứt và màu lặng để người đọc thấy
+ * đây là *chỗ trống đã biết*, không phải dữ liệu bị hỏng.
+ */
+.tw-assignee.none {
+  background: transparent;
+  color: var(--ink-3);
+  border: 1px dashed var(--line-2);
+}
+
+/* ---- drawer chi tiết: hai cột như trang issue của Jira ---- */
+
+.tw-d-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 230px;
+  gap: 22px;
+  align-items: start;
+}
+@media (max-width: 660px) {
+  .tw-d-grid { grid-template-columns: 1fr; }
+  .tw-d-side { border-top: 1px solid var(--line); padding-top: 16px; }
+}
+
+.tw-d-side {
+  border-left: 1px solid var(--line);
+  padding-left: 18px;
+}
+@media (max-width: 660px) { .tw-d-side { border-left: 0; padding-left: 0; } }
+
+.tw-d-field { margin-bottom: 18px; }
+.tw-d-field:last-child { margin-bottom: 0; }
+.tw-d-val { font-size: 13.5px; color: var(--ink); line-height: 1.5; }
+.tw-d-big {
+  font-size: 26px;
+  font-weight: 700;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+  line-height: 1.1;
+  margin: 2px 0 3px;
+}
+
+/* Trích nguyên văn câu trả lời ngắn của ADR — kẻ trái, không nghiêng. */
+.tw-quote {
+  border-left: 2px solid var(--lime);
+  padding: 8px 12px;
+  background: var(--panel-2);
+  border-radius: 0 8px 8px 0;
+  font-size: 13px;
+  color: var(--ink-2);
+  line-height: 1.55;
+}
+
+/* Dòng thời gian: chỉ mốc có thật, và nói rõ nó KHÔNG phải lịch sử thao tác. */
+.tw-timeline { margin: 8px 0 10px; }
+.tw-tl {
+  display: grid;
+  grid-template-columns: 12px 1fr;
+  gap: 10px;
+  padding-bottom: 12px;
+  position: relative;
+}
+.tw-tl:last-child { padding-bottom: 0; }
+.tw-tl:not(:last-child)::before {
+  content: '';
+  position: absolute;
+  left: 5px;
+  top: 14px;
+  bottom: 0;
+  width: 1px;
+  background: var(--line);
+}
+.tw-tl-dot {
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  border: 2px solid var(--lime);
+  background: var(--panel);
+  margin-top: 3px;
+}
+.tw-tl-t { font-size: 13px; color: var(--ink-2); line-height: 1.45; }
+.tw-tl-t b { color: var(--ink); }
+.tw-tl-w {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10.5px;
+  color: var(--ink-3);
+  margin-top: 1px;
+}
+
+.tw-d-note {
+  border-top: 1px solid var(--line);
+  padding-top: 16px;
+  margin-top: 6px;
+}
+
+/* ------------------------------------------------------------------ drawer */
+
+.tw-drawer-back {
+  position: fixed;
+  inset: 0;
+  background: rgba(4, 6, 3, .62);
+  z-index: 40;
+}
+.tw-drawer {
+  position: fixed;
+  top: 0;
+  right: 0;
+  height: 100vh;
+  width: min(520px, 94vw);
+  background: var(--panel);
+  border-left: 1px solid var(--line-2);
+  z-index: 50;
+  display: flex;
+  flex-direction: column;
+}
+
+/*
+ * THUỘC TÍNH `hidden` PHẢI THẮNG `display`.
+ *
+ * Lỗi đã mắc: `aside.tw-drawer[hidden]` vẫn hiện, nút ✕ bấm không đóng được.
+ *
+ * `hidden` trong HTML không phải một luật của trang — nó chỉ là một rule
+ * `display: none` do USER-AGENT đặt. Theo cascade, khai báo của TÁC GIẢ luôn
+ * thắng khai báo của user-agent, KHÔNG phụ thuộc thứ tự cũng không phụ thuộc
+ * độ đặc hiệu. Nên `.tw-drawer { display: flex }` ở trên đè `hidden` — dù nó
+ * viết trước hay sau. `el.hidden = true` chạy đúng, `aria-hidden` đổi đúng,
+ * chỉ màn hình không đổi.
+ *
+ * `!important` là thứ duy nhất đảo được thứ hạng đó: `!important` của tác giả
+ * nằm trên mọi khai báo thường của tác giả. Đừng "dọn" nó đi.
+ *
+ * Cùng lỗi này đã mắc ở `app.css` (`#oq-count`, class `.badge` có
+ * `display: inline-flex`) ⇒ `scripts/check_hidden_attr.mjs` canh cả hai.
+ */
+[hidden] { display: none !important; }
+.tw-drawer-head {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  padding: 18px 18px 14px;
+  border-bottom: 1px solid var(--line);
+}
+.tw-drawer-head h2 {
+  margin: 6px 0 0;
+  font-size: 17px;
+  line-height: 1.35;
+  letter-spacing: -.01em;
+}
+.tw-x {
+  margin-left: auto;
+  background: transparent;
+  border: 1px solid var(--line-2);
+  color: var(--ink-2);
+  border-radius: 8px;
+  width: 30px;
+  height: 30px;
+  cursor: pointer;
+  font-size: 13px;
+}
+.tw-x:hover { color: var(--ink); border-color: var(--ink-3); }
+.tw-drawer-body { padding: 16px 18px 30px; overflow-y: auto; }
+.tw-d-sec { margin-bottom: 18px; }
+.tw-d-label {
+  font-size: 11px;
+  text-transform: uppercase;
+  letter-spacing: .09em;
+  color: var(--ink-3);
+  font-weight: 600;
+  margin-bottom: 5px;
+}
+.tw-d-sec p { margin: 0 0 8px; color: var(--ink-2); font-size: 13.5px; }
+.tw-q { border-left: 2px solid var(--line-2); padding-left: 10px; }
+
+/* --------------------------------------------------------------- why panel */
+
+.tw-why {
+  margin: 34px 0 60px;
+  border-top: 1px solid var(--line);
+  padding-top: 24px;
+}
+.tw-why h2 { font-size: 18px; margin: 0 0 16px; letter-spacing: -.01em; }
+.tw-two {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 24px;
+}
+@media (max-width: 760px) { .tw-two { grid-template-columns: 1fr; } }
+.tw-two h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin: 0 0 8px; }
+.tw-two ul { margin: 0; padding-left: 18px; color: var(--ink-2); font-size: 13.5px; }
+.tw-two li { margin-bottom: 7px; }
+.tw-why .tw-fine { margin-top: 18px; }
+
+@media (prefers-reduced-motion: reduce) {
+  .tw-card { transition: none; }
+  .tw-card:hover { transform: none; }
+}
