index 0000000..6628487
--- /dev/null
+++ b/scripts/check_adr_structure.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""check_adr_structure.py — ADR phải có bốn mục bắt buộc. Đóng §3.3 của ADR-0043.
+
+VÌ SAO CÓ SCRIPT NÀY
+--------------------
+`ADR-0043` §3.3 ghi: repo đã có nhiều ADR **tự nguyện** ghi mục *"điều ADR này KHÔNG bao gồm"*
+(`ADR-0023` §3, `ADR-0040` §8, `ADR-0042` §6) nhưng **không bắt buộc** — nên có lúc thiếu. Và
+một yêu cầu không ghi "ngoài phạm vi" thì mặc định được hiểu là **sẽ làm**.
+
+Nếu chỉ thêm mục đó vào một tệp mẫu thì nó vẫn là **lời khuyên**. Script này biến nó thành **cổng**.
+
+BỐN MỤC BẮT BUỘC
+----------------
+  1. `## 0. Trả lời ngắn`                     — người đọc quyết trong 30 giây
+  2. mục có tiêu đề chứa "KHÔNG bao gồm"      — chống scope creep
+  3. mục có tiêu đề chứa "Ranh giới trung thực" — cái gì chưa kiểm/chưa chạy
+  4. ba dòng header: `**Trạng thái:**`, `**Ngày:**`, `**Người quyết:**`
+
+CỐ Ý KHÔNG KIỂM
+---------------
+Không kiểm **nội dung** của mục 2/3. Một mục ghi "không có gì ngoài phạm vi" sẽ **qua** cổng này
+nhưng vẫn là ADR dở. Máy không phân biệt được "trung thực" với "đủ chỗ trống" — và cố kiểm sẽ sinh
+ra cổng giả. Đây là ranh giới đã ghi ở [`gates/README.md`](../docs/gates/README.md):
+*"CI xanh ≠ gate pass"*.
+
+Dùng:
+    python3 scripts/check_adr_structure.py            # báo cáo, exit 1 nếu thiếu
+    python3 scripts/check_adr_structure.py --quiet     # chỉ in khi có lỗi
+    python3 scripts/check_adr_structure.py --grandfather   # in số ADR cũ còn thiếu (không fail)
+"""
+from __future__ import annotations
+
+import glob
+import os
+import re
+import sys
+
+os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+QUIET = "--quiet" in sys.argv
+GRANDFATHER = "--grandfather" in sys.argv
+
+#: ADR được **miễn** vì viết trước khi mẫu này ra đời (2026-11-18) và đã có hiệu lực.
+#: Danh sách này **chỉ được ngắn lại**, không được dài ra. Thêm một mã vào đây là một quyết định,
+#: không phải một tiện lợi.
+#:
+#: ⚠️ Mốc là **ADR-0026**, không phải "mọi ADR cũ hơn hôm nay": ADR-0027…0043 cũng đề ngày
+#: 2026-11-22/18 nhưng **cùng đợt** với mẫu. Miễn chúng sẽ làm cổng vô dụng ngay khi ra đời —
+#: và đó là cách một cổng trở thành đồ trang trí.
+GRANDFATHERED: dict[str, str] = {
+    # ADR-0001…0026: không có mục 0 / phạm vi ngoài / ranh giới trung thực.
+    **{f"ADR-{n:04d}": "viết trước mẫu 2026-11-18" for n in range(1, 27)},
+}
+
+#: Ba dòng header bắt buộc.
+REQUIRED_HEADER = ["**Trạng thái:**", "**Ngày:**", "**Người quyết:**"]
+
+#: Hai mục nội dung bắt buộc (so khớp trên tiêu đề `##`, không phân biệt hoa thường).
+#: Mục "ranh giới trung thực" nhận **hai tên**, vì cả hai đang được dùng thật trong repo và
+#: cùng một nội dung: `ADR-0027`…`ADR-0030` viết dưới tên **"Tự phê bình"**, `ADR-0035` trở đi dùng
+#: **"Ranh giới trung thực"**. Ép đổi tên là cổng giả — xem ghi chú ở `headings()`.
+REQUIRED_SECTIONS = [
+    ("trả lời ngắn", "mục 0 — người đọc quyết trong 30 giây"),
+    ("ranh giới trung thực|tự phê bình", "mục nêu cái gì CHƯA kiểm/chưa chạy"),
+]
+
+#: Mục "Điều ADR này KHÔNG bao gồm" là bắt buộc, nhưng **tiêu đề tự do** — miễn là nội dung
+#: thật sự nêu phạm vi ngoài. Lý do: lần chạy đầu, cổng này báo **17/17 ADR đỏ** chỉ vì chúng
+#: dùng tiêu đề khác cho **cùng một nội dung đã có**:
+#:
+#:   ADR-0042 §6  "Điều tôi KHÔNG làm, và vì sao"
+#:   ADR-0040 §5  "Tên cho tầng mới — và vì sao tôi KHÔNG đặt tên ngay"
+#:   ADR-0038 §5  "Ba thứ OpenRouter KHÔNG được làm trong Game9K"
+#:
+#: Ép 17 ADR đổi tiêu đề để khớp một chuỗi là **cổng giả**: nó đo cách đặt tên, không đo nội dung.
+#: Nên cổng nhận **một trong hai**: tiêu đề khớp, **hoặc** một mục có nội dung nêu rõ phạm vi
+#: ngoài (bảng "Không bao gồm" / câu "không làm" / "ngoài phạm vi").
+SCOPE_TITLE_HINTS = ("không bao gồm", "không làm", "ngoài phạm vi", "không áp", "không dùng")
+SCOPE_BODY_HINTS = (
+    "không bao gồm", "ngoài phạm vi", "không làm", "không áp dụng",
+    "không dùng", "không đặc tả", "không cài",
+)
+
+
+def adr_id(path: str) -> str:
+    m = re.search(r"(ADR-\d{4})", os.path.basename(path))
+    return m.group(1) if m else "?"
+
+
+def headings(text: str) -> list[str]:
+    """Tiêu đề `##`, đã bỏ markdown đậm/nghiêng.
+
+    VÌ SAO PHẢI BỎ `*`: lần chạy đầu cổng báo ADR-0042 đỏ dù §6 tên là
+    "Điều tôi **không** làm, và vì sao" — có `**` xen giữa "không" và "làm", nên so chuỗi
+    thô không khớp. Đây là lỗi **của cổng**, không phải của ADR: cùng một câu, viết đậm hay
+    không đậm là như nhau. Một cổng đo cách trình bày thay vì đo nội dung là cổng giả.
+    """
+    raw = re.findall(r"^##\s+(.+)$", text, re.M)
+    return [re.sub(r"[*_`]", "", h).strip().lower() for h in raw]
+
+
+def _has_scope_section(text: str) -> bool:
+    """Có mục `##` nào mà THÂN của nó nêu rõ phạm vi ngoài không?
+
+    Đây là phép đo **yếu hơn** khớp tiêu đề, và nó cố ý yếu: nó chỉ khẳng định *có một câu nói
+    "không làm/ngoài phạm vi" trong một mục*, không khẳng định câu đó **đủ**. Máy không phân biệt
+    được "ghi phạm vi ngoài trung thực" với "ghi một câu cho có" — cố kiểm sẽ sinh cổng giả.
+    """
+    # Tách theo heading `##`, giữ tiêu đề + thân.
+    parts = re.split(r"^##\s+", text, flags=re.M)
+    for part in parts[1:]:  # phần [0] là trước heading đầu tiên
+        body = part.lower()
+        if any(hint in body for hint in SCOPE_BODY_HINTS):
+            return True
+    return False
+
+
+def main() -> int:
+    files = sorted(glob.glob("docs/08-adr/ADR-*.md"))
+    problems: list[str] = []
+    ok = 0
+    grandfathered = 0
+
+    for path in files:
+        ident = adr_id(path)
+        text = open(path, encoding="utf-8").read()
+
+        if ident in GRANDFATHERED:
+            grandfathered += 1
+            continue
+
+        missing = []
+        for line in REQUIRED_HEADER:
+            if line not in text:
+                missing.append(f"thiếu dòng `{line}`")
+
+        hs = headings(text)
+        for needle, why in REQUIRED_SECTIONS:
+            # Bọc `(?:…)` để `|` không bị hiểu là "khớp bất kỳ ký tự nào":
+            #   `re.compile("a|b")` khớp "a" HOẶC "b" — nhưng `"ranh giới trung thực|tự phê bình"`
+            #   không neo hai đầu, nên một tiêu đề như "Kiểm" vẫn có thể khớp qua nhánh rỗng.
+            #   Bọc nhóm + đòi khớp cả cụm từ là cách chắc chắn.
+            pat = re.compile(r"(?:" + needle + r")")
+            if not any(pat.search(h) for h in hs):
+                missing.append(f"thiếu mục `## … {needle} …` ({why})")
+
+        # Mục phạm vi ngoài: tiêu đề khớp, HOẶC có mục mà THÂN nêu rõ "không làm/ngoài phạm vi".
+        if not any(hint in h for h in hs for hint in SCOPE_TITLE_HINTS):
+            if not _has_scope_section(text):
+                missing.append(
+                    "thiếu mục nêu **phạm vi ngoài** — tiêu đề chứa 'KHÔNG bao gồm'/'KHÔNG làm'/"
+                    "'ngoài phạm vi', hoặc một mục có câu 'không làm/ngoài phạm vi' (ADR-0043 §3.3)",
+                )
+
+        if missing:
+            problems.append(f"{os.path.basename(path)}: " + " · ".join(missing))
+        else:
+            ok += 1
+
+    if GRANDFATHER:
+        if not QUIET:
+            print(f"ADR miễn (viết trước mẫu): {grandfathered}")
+            print(f"ADR đã theo mẫu: {ok}")
+        return 0
+
+    if problems:
+        print(f"\n## ❌ {len(problems)} ADR thiếu mục bắt buộc — xem docs/08-adr/_TEMPLATE.md\n")
+        for p in problems:
+            print(f"  ❌ {p}")
+        print(f"\n  Đã theo mẫu: {ok} · Miễn (trước 2026-11-18): {grandfathered}")
+        print("\n  Sửa: thêm mục còn thiếu. Không thêm mã vào GRANDFATHERED để né cổng.")
+        print(f"## ❌ {len(problems)}/{len(problems) + ok} kiểm tra THẤT BẠI")
+        return 1
+
+    if not QUIET:
+        print(f"\n## ✅ {ok}/{ok} kiểm tra đạt — mọi ADR (từ 0027) đủ bốn mục bắt buộc")
+        print(f"   Miễn: {grandfathered} ADR viết trước mẫu 2026-11-18 · Mẫu: docs/08-adr/_TEMPLATE.md")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
