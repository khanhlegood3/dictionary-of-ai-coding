+#!/usr/bin/env python3
+"""CI chặn `portal/public/work-items.generated.mjs` trôi khỏi tài liệu nguồn.
+
+Vì sao cần: cùng lý do `check_backlog_sync.py`. Portal không đọc được `docs/` trên
+production (`.vercelignore`), nên dữ liệu phải **sinh** và **commit**. Một tệp sinh
+mà không ai kiểm là một bản sao sẽ lệch — và bảng việc hiển thị cho nhà đầu tư sẽ
+nói về một trạng thái dự án không còn đúng.
+
+Đây là loại lỗi tệ nhất trong repo này: **không có gì đỏ**, chỉ có một con số sai
+trông rất hợp lý. Cùng họ với `gen_portal_data.py --check`.
+
+Hai tầng:
+  1. Sinh lại rồi so từng byte với bản đã commit.
+  2. Kiểm chính bộ trích xuất: nó phải đọc được **mọi** ADR, và số câu hỏi phải
+     khác 0 — vì đã có lúc nó báo 0 câu hỏi trong khi tài liệu có 48.
+
+Chạy:  python3 scripts/check_work_items_sync.py
+"""
+
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+GEN = ROOT / "portal" / "public" / "work-items.generated.mjs"
+ADR_DIR = ROOT / "docs" / "08-adr"
+
+FAILS: list[str] = []
+OKS = 0
+
+
+def ok(msg):
+    global OKS
+    OKS += 1
+
+
+def need(cond, msg):
+    if cond:
+        ok(msg)
+    else:
+        FAILS.append(msg)
+
+
+print("=== 1. Bộ sinh chạy lại và khớp bản đã commit ===")
+proc = subprocess.run(
+    ["node", "scripts/extract_work_items.mjs", "--check"],
+    cwd=ROOT, capture_output=True, text=True,
+)
+need(proc.returncode == 0,
+     "work-items.generated.mjs khớp tài liệu (chạy `node scripts/extract_work_items.mjs`)")
+if proc.returncode != 0:
+    for line in (proc.stderr or proc.stdout).strip().splitlines():
+        print(f"    {line}")
+
+print("\n=== 2. Bộ trích xuất đọc được ĐỦ ADR, không bỏ sót im lặng ===")
+adr_files = sorted(p for p in ADR_DIR.glob("ADR-*.md"))
+need(len(adr_files) > 0, "tìm thấy tệp ADR trong docs/08-adr")
+
+src = GEN.read_text(encoding="utf-8")
+m = re.search(r"export const WORK_STATS = (\{.*?\});", src, re.S)
+need(m is not None, "work-items.generated.mjs có WORK_STATS")
+stats = json.loads(m.group(1)) if m else {}
+
+# Bản đầu của bộ sinh chỉ đọc 25/43 ADR và báo 0 câu hỏi — cả hai đều xanh CI.
+need(stats.get("adrTotal") == len(adr_files),
+     f"đọc đủ {len(adr_files)} ADR (thực tế: {stats.get('adrTotal')})")
+need(stats.get("adrQuestions", 0) > 0,
+     f"đếm được câu hỏi Q-ADR* chưa trả lời (thực tế: {stats.get('adrQuestions')})")
+need(stats.get("adrOpen", 0) <= stats.get("adrTotal", 0),
+     "số ADR còn mở không vượt quá tổng số ADR")
+
+print("\n=== 3. Không có giá trị rác trong tệp sinh ===")
+# `undefined` từng xuất hiện 25 lần vì một lần vá script làm hỏng dấu `\` trong
+# `replace(/\\*\\*/g, '')` ⇒ nó gọi replace với 1 đối số ⇒ chèn chữ "undefined".
+need("undefined" not in src, "không có chuỗi 'undefined' trong tệp sinh")
+need("NaN" not in src, "không có 'NaN' trong tệp sinh")
+
+print("\n=== 4. Ranh giới: tệp sinh KHÔNG chứa issue ===")
+# Kiểm theo KHOÁ của object, không grep chữ thô.
+#
+# Bài học đã trả giá hai lần trong hôm nay: grep chữ thô trên tệp sinh bắt được
+# cả chữ "assignee" nằm trong NGUYÊN VĂN một câu hỏi của ADR-0042 ("Có cần lọc
+# theo người phụ trách (assignee_id)?"). Đó là false positive: câu hỏi đó đúng là
+# một việc tồn. Muốn kiểm "tệp này không tự nhận chủ" thì phải kiểm KHOÁ.
+m_items = re.search(r"export const WORK_ITEMS = (\[.*?\]);\n\nexport const WORK_STATS", src, re.S)
+need(m_items is not None, "WORK_ITEMS parse được")
+items = json.loads(m_items.group(1)) if m_items else []
+need(len(items) > 0, "WORK_ITEMS không rỗng")
+
+#: Khoá được phép. Bốn khoá cuối thêm khi `/tasks` mượn khuôn Jira (2026-11-24) —
+#: và chúng được phép CHỈ vì mỗi khoá đều suy ra được từ tài liệu, không phải
+#: dữ liệu mô phỏng. Xem khối chú thích "TRƯỜNG SUY RA ĐƯỢC" trong
+#: `scripts/extract_work_items.mjs`, và `check_tasks_page.mjs` §2b kiểm chúng.
+ALLOWED_KEYS = {"id", "title", "status", "open", "href", "shortAnswer",
+                "questions", "outOfScope", "unmeasured", "weight",
+                "priority", "points", "assignee", "updatedAt", "blocking"}
+extra = sorted({k for it in items for k in it} - ALLOWED_KEYS)
+need(not extra, f"mọi item chỉ có khoá đã khai (thấy thêm: {extra})".replace("[]", "không"))
+
+# Điều cấm KHÔNG đổi, dù giờ có khoá `assignee`: việc tồn vẫn không được TỰ NHẬN
+# chủ theo nghĩa "người làm". `assignee` ở đây là người **chịu trách nhiệm quyết**
+# đọc từ header ADR, nên nó phải khớp `**Người quyết:**` của chính tệp nguồn —
+# không được là một id thành viên do bảng tự gán.
+need(all(it.get("assignee") is None or isinstance(it.get("assignee"), str) for it in items),
+     "assignee là null hoặc chuỗi tên — không phải id thành viên")
+need(not any("assignee_id" in it for it in items),
+     "không item nào có assignee_id — việc tồn không tự nhận chủ")
+need(all("issue_key" not in it for it in items),
+     "không item nào có issue_key — đây không phải nguồn issue")
+
+gen_src = (ROOT / "scripts" / "extract_work_items.mjs").read_text(encoding="utf-8")
+# Kiểm HÀNH VI (không có lời gọi mạng), không kiểm chữ "github.com" — đường dẫn
+# `href` tới tệp ADR trên GitHub là hợp lệ và cần thiết.
+need("fetch(" not in gen_src, "bộ sinh không gọi mạng (không có `fetch(`)")
+need("api.github.com" not in gen_src, "bộ sinh không gọi API GitHub")
+
+print()
+if FAILS:
+    print(f"## ❌ {len(FAILS)} kiểm tra THẤT BẠI trong {OKS + len(FAILS)}")
+    for f in FAILS:
+        print(f"  ❌ {f}")
+    sys.exit(1)
+print(f"## ✅ {OKS}/{OKS} kiểm tra đạt — bảng việc khớp tài liệu nguồn")
