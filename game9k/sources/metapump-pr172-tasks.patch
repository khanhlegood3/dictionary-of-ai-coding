+ * mở bằng điện thoại.
+ */
+.hero::before {
+  content: '';
+  position: absolute; inset: 0;
+  background-image:
+    linear-gradient(rgba(242, 237, 226, .045) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(242, 237, 226, .045) 1px, transparent 1px);
+  background-size: 56px 56px;
+  pointer-events: none;
+  mask-image: radial-gradient(ellipse 90% 70% at 20% 0%, #000 40%, transparent 100%);
+  -webkit-mask-image: radial-gradient(ellipse 90% 70% at 20% 0%, #000 40%, transparent 100%);
+}
+
+.hero-inner {
+  position: relative;
+  padding: 62px 0 54px;
+  display: grid;
+  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
+  gap: 56px;
+  align-items: start;
+}
+@media (max-width: 1000px) {
+  .hero-inner { grid-template-columns: 1fr; gap: 34px; padding: 44px 0 40px; }
+}
+
+.hero-eyebrow {
+  display: inline-flex; align-items: center; gap: 9px;
+  font-family: var(--mono); font-size: 10px; letter-spacing: .16em;
+  text-transform: uppercase; font-weight: 600;
+  color: var(--amber);
+  border: 1px solid rgba(240, 169, 30, .32);
+  background: rgba(240, 169, 30, .09);
+  padding: 5px 11px; border-radius: 999px;
+  margin-bottom: 22px;
+}
+.hero-eyebrow .dot {
+  width: 5px; height: 5px; border-radius: 50%; background: var(--amber);
+  box-shadow: 0 0 8px var(--amber);
+}
+
+/*
+ * Tiêu đề lớn dùng serif, cỡ theo viewport. Trên nền navy, serif sáng đọc ra
+ * như bìa báo cáo thường niên — đúng giọng điệu cần, và khác hẳn một landing
+ * page sản phẩm.
+ */
+.hero h1 {
+  color: #fbf7ef;
+  font-size: clamp(34px, 4.6vw, 58px);
+  line-height: 1.05;
+  letter-spacing: -.028em;
+  margin-bottom: 18px;
+  max-width: 20ch;
+}
+.hero h1 em {
+  font-style: italic;
+  color: var(--amber);
+  font-weight: 500;
+}
+
+.hero-lede {
+  color: rgba(242, 237, 226, .76);
+  font-size: 16px;
+  line-height: 1.7;
+  max-width: 60ch;
+}
+
+.hero-actions { display: flex; gap: 11px; flex-wrap: wrap; margin-top: 26px; }
+
+/* ---- danh sách bảo chứng: bốn dòng, mỗi dòng một điều người đọc cần tin ---- */
+.hero-facts {
+  display: grid; gap: 1px;
+  background: rgba(242, 237, 226, .12);
+  border: 1px solid rgba(242, 237, 226, .12);
+  border-radius: var(--r);
+  overflow: hidden;
+}
+.hero-fact {
+  background: var(--navy);
+  padding: 15px 17px;
+  display: grid; grid-template-columns: 26px 1fr; gap: 12px;
+  align-items: start;
+}
+.hero-fact .k {
+  font-family: var(--mono); font-size: 10px; letter-spacing: .06em;
+  color: var(--amber); padding-top: 2px; font-weight: 700;
+}
+.hero-fact .t { font-size: 13px; color: #f2ede2; line-height: 1.45; font-weight: 520; }
+.hero-fact .d { font-size: 11.5px; color: rgba(242, 237, 226, .55); line-height: 1.5; margin-top: 3px; }
+
+/* ---- dải chỉ số ngay dưới hero: ba con số đọc từ repo ---- */
+.hero-strip {
+  border-top: 1px solid var(--navy-2);
+  background: rgba(0, 0, 0, .18);
+}
+.hero-strip .shell {
+  display: flex; gap: 40px; flex-wrap: wrap;
+  padding: 16px 28px;
+  align-items: center;
+}
+.hero-stat { display: flex; align-items: baseline; gap: 8px; }
+.hero-stat .n {
+  font-family: var(--serif); font-size: 20px; font-weight: 600;
+  color: #fbf7ef; font-variant-numeric: tabular-nums; letter-spacing: -.02em;
+}
+.hero-stat .l {
+  font-family: var(--mono); font-size: 10px; letter-spacing: .12em;
+  text-transform: uppercase; color: rgba(242, 237, 226, .5);
+  font-weight: 600;
+}
+.hero-strip .spacer { flex: 1; }
+.hero-strip .note {
+  font-size: 11.5px; color: rgba(242, 237, 226, .45);
+  font-family: var(--mono); letter-spacing: .03em;
+}
