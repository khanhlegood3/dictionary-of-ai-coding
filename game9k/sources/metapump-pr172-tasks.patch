+  const quote = shortAnswerOf('## 0. Trả lời ngắn\n\n> Đây là quyết định viết trong blockquote đủ dài.\n\n## 1. X\n');
+  assert.match(quote, /quyết định viết trong blockquote/);
+
+  // (c) bảng không có ô tiêu đề, có `---` chen giữa
