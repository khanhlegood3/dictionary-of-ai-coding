+    // Cắt cứng bằng `slice` phải kèm dấu …, không để câu đứt giữa từ.
+    // Bộ sinh chỉ cắt khi vượt 320 ký tự (cắt ở ranh giới từ, kèm `…`). Dưới
+    // ngưỡng đó thì KHÔNG được cắt — đây chính là lỗi trước: cắt ngầm ở 237.
+    assert.ok(it.shortAnswer.length <= 330,
+      `${it.id} tóm tắt dài ${it.shortAnswer.length} ký tự — vượt ngưỡng cắt`);
+  }
+});
