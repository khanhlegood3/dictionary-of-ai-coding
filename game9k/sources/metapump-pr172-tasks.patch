new file mode 100644
index 0000000..b4c2d2e
--- /dev/null
+++ b/scripts/check_tasks_page.mjs
@@ -0,0 +1,426 @@
+#!/usr/bin/env node
+/**
+ * check_tasks_page.mjs — kiểm trang `/tasks` bằng jsdom + server thật.
+ *
+ * ## Vì sao phải kiểm bằng DOM thật, không chỉ kiểm HTTP 200
+ *
+ * Lần dựng trang này đã mắc đúng một lỗi mà HTTP 200 **không** bắt được: trang
+ * trả 200, `tasks.js` trả 200, nhưng bảng **rỗng** — vì bộ sinh ghi dữ liệu vào
+ * `portal/lib/` (server không phục vụ) nên `import` 404 và script chết im lặng.
+ * Kiểm `curl -o /dev/null -w %{http_code}` cho ra một hàng 200 đẹp.
+ *
+ * Nên: chạy `tasks.js` thật trên DOM thật, rồi **đếm thẻ**. Rỗng là đỏ.
+ *
+ * ## Cách nạp module
+ *
+ * jsdom không thực thi `<script type="module">` (không có module loader). Nên
+ * test nạp dữ liệu và `tasks.js` bằng `window.eval`, chỉ thay **một** dòng
+ * `import` bằng chỗ nối tới dữ liệu đã nạp trước. Phần còn lại của `tasks.js`
+ * là nguyên văn — cùng mã mà trình duyệt chạy.
+ *
+ * Giới hạn phải nói rõ: cách này KHÔNG kiểm đường tải module qua HTTP (CSP,
+ * MIME, đường dẫn). Phần đó kiểm bằng `fetch` riêng bên dưới.
+ *
+ * Chạy: npm i --no-save jsdom && node scripts/check_tasks_page.mjs
+ * Thiếu jsdom ⇒ SKIP (giống check_portal_ui.mjs), trừ khi TASKS_UI_REQUIRE=1.
+ */
+
+import { spawn } from 'node:child_process';
+import path from 'node:path';
+import fs from 'node:fs';
+
+const ROOT = path.resolve(import.meta.dirname, '..');
+
+let JSDOM;
+try {
+  ({ JSDOM } = await import('jsdom'));
+} catch {
+  if (process.env.TASKS_UI_REQUIRE === '1') {
+    console.error('❌ Thiếu jsdom nhưng TASKS_UI_REQUIRE=1 — không được phép bỏ qua.');
+    process.exit(1);
+  }
+  console.log('⚠️  SKIP check_tasks_page — thiếu jsdom (npm i --no-save jsdom)');
+  process.exit(0);
+}
+
+const results = [];
+const ok = (n) => results.push({ ok: true, name: n });
+const bad = (n, why) => results.push({ ok: false, name: n, why });
+const assert = (cond, name, why = '') => (cond ? ok(name) : bad(name, why));
+
+/* ------------------------------------------------------------ start server */
+
+const port = 8793;
+const srv = spawn(process.execPath, ['portal/server.mjs'], {
+  cwd: ROOT,
+  env: { ...process.env, PORT: String(port), PORTAL_DB: ':memory:', PORTAL_GITHUB: 'simulate' },
+  stdio: ['ignore', 'pipe', 'pipe'],
+});
+const base = `http://127.0.0.1:${port}`;
+for (let i = 0; i < 80; i++) {
+  try {
+    const r = await fetch(`${base}/api/me`);
+    if (r.status) break;
+  } catch { /* chờ */ }
+  await new Promise((r) => setTimeout(r, 150));
+}
+
+try {
+  /* ------------------------------------------- 1. tài nguyên tải được, MIME đúng */
+
+  const page = await fetch(`${base}/tasks`);
+  const html = await page.text();
+  assert(page.ok, 'GET /tasks trả 200', `status ${page.status}`);
+  assert(html.includes('tw-board'), '/tasks có khung bảng việc');
+
+  // Đọc ĐÚNG đường mà trình duyệt sẽ đọc trên production: lấy từ chính
+  // `tasks.html`, không phải danh sách viết tay. Bản trước kiểm `/tasks.js` và
+  // `/tasks.css` — đường mà HTML *không* dùng — nên xanh trong khi production
+  // 404 cả hai (vercel.json rewrite `/tasks/:path*` nuốt mất).
+  // TÀI NGUYÊN = thứ trình duyệt phải TẢI để trang chạy: `<link rel=stylesheet>`,
+  // `<script src>`, `<img src>`. KHÔNG gồm `<a href>` — một link điều hướng trỏ
+  // tới `/portal` là đúng, và nó không bị 404 làm hỏng trang.
+  // (Bản đầu gom mọi `href|src` nên báo đỏ vì `/portal` — false positive.)
+  const assetUrls = [
+    ...html.matchAll(/<link[^>]+href="(\/[^"]+)"/g),
+    ...html.matchAll(/<script[^>]+src="(\/[^"]+)"/g),
+    ...html.matchAll(/<img[^>]+src="(\/[^"]+)"/g),
+  ].map((m) => m[1]);
+  assert(assetUrls.length > 0, 'tasks.html có tài nguyên cùng origin');
+
+  for (const u of new Set(assetUrls)) {
+    const r = await fetch(base + u);
+    const ct = r.headers.get('content-type') || '';
+    const expectJs = u.endsWith('.js') || u.endsWith('.mjs');
+    const expectCss = u.endsWith('.css');
+    const want = expectJs ? 'text/javascript' : expectCss ? 'text/css' : 'text/html';
+    assert(r.ok && ct.startsWith(want),
+      `tài nguyên HTML trỏ tới phải tải được: ${u}`,
+      `status ${r.status}, type ${ct}`);
+  }
+
+  // Và KHÔNG được trỏ tới đường mà rewrite của Vercel sẽ nuốt. `/tasks.css` khớp
+  // `/tasks/:path*` ⇒ đi vào function với đường dẫn `/tasks.css`, mà bộ định
+  // tuyến của portal không có route đó ⇒ 404.
+  const cfg = JSON.parse(fs.readFileSync(path.join(ROOT, 'vercel.json'), 'utf8'));
+  const catchAlls = cfg.rewrites.filter((r) => r.source.endsWith('/:path*'))
+    .map((r) => r.source.slice(0, -'/:path*'.length));
+  for (const u of assetUrls) {
+    const swallowed = catchAlls.find((pre) => u === pre || u.startsWith(pre + '/'));
+    assert(!swallowed || u.startsWith('/assets/'),
+      `tài nguyên ${u} không bị rewrite "${swallowed}/:path*" nuốt (hoặc phải nằm dưới /assets/)`,
+      `khớp ${swallowed}/:path*`);
+  }
+
+  for (const [u, type] of [
+    ['/tasks.js', 'text/javascript'],
+    ['/tasks.css', 'text/css'],
+    ['/assets/work-items.generated.mjs', 'text/javascript'],
+  ]) {
+    const r = await fetch(base + u);
+    const ct = r.headers.get('content-type') || '';
+    // `application/octet-stream` cho `.mjs` ⇒ trình duyệt TỪ CHỐI nạp module,
+    // cả trang chết im lặng. Đây là lỗi đã mắc ở playground (xem serve()).
+    assert(r.ok && ct.startsWith(type), `GET ${u} → 200 + ${type}`, `status ${r.status}, type ${ct}`);
+  }
+
+  const csp = page.headers.get('content-security-policy') || '';
+  assert(csp.includes("script-src 'self'"), '/tasks có CSP script-src self');
+  assert(csp.includes("default-src 'self'"), '/tasks có CSP default-src self');
+
+  /* ---------------------------------------- 2. chạy tasks.js trên DOM thật */
+
+  // `runScripts: 'dangerously'` là BẮT BUỘC để `window.eval` chạy trong realm
+  // của trang. Không có nó, jsdom không cấp eval cho window và mã được chạy ở
+  // scope Node — `document`/`window` biến mất, và test báo "0 thẻ" thay vì báo
+  // lỗi cấu hình. Đây là lỗi đã mắc đúng một lần ở chính test này.
+  const dom = new JSDOM(html, { url: `${base}/tasks`, runScripts: 'dangerously', pretendToBeVisual: true });
+  const { window } = dom;
+
+  // Nạp module dữ liệu: bóc `export ` rồi lấy giá trị trả về của một hàm bao.
+  const dataSrc = await (await fetch(`${base}/assets/work-items.generated.mjs`)).text();
+  const dataFactory = `(function(){${dataSrc.replace(/^export const /gm, 'const ')}
+    return { WORK_ITEMS, WORK_STATS };})()`;
+  const data = window.eval(dataFactory);
+  assert(Array.isArray(data.WORK_ITEMS) && data.WORK_ITEMS.length > 0,
+    'module dữ liệu nạp được và có item',
+    `WORK_ITEMS = ${data.WORK_ITEMS && data.WORK_ITEMS.length}`);
+  assert(data.WORK_STATS && data.WORK_STATS.adrTotal > 0, 'module dữ liệu có WORK_STATS');
+
+  const jsUrl = assetUrls.find((u) => u.endsWith('.js'));
+  let js = await (await fetch(base + jsUrl)).text();
+  const importRe = /^import\s+\{[^}]*\}\s+from\s+'[^']*';\s*$/m;
+  assert(importRe.test(js), 'tasks.js có đúng một dòng import (test sẽ thay dòng đó)');
+  // Nối dữ liệu TRỰC TIẾP vào chuỗi, không qua biến toàn cục: eval được gọi trên
+  // `window`, và một biến Node không tự trở thành biến của realm trang.
+  js = js.replace(importRe,
+    `const { WORK_ITEMS, WORK_STATS } = JSON.parse(${JSON.stringify(JSON.stringify({ WORK_ITEMS: data.WORK_ITEMS, WORK_STATS: data.WORK_STATS }))});`);
+
+  let evalErr = null;
+  try {
+    window.eval(js);
+  } catch (e) {
+    evalErr = e;
+  }
+  assert(!evalErr, 'tasks.js chạy không lỗi', evalErr && evalErr.message);
+
+  const d = window.document;
+  const cards = d.querySelectorAll('.tw-card');
+  const cols = d.querySelectorAll('.tw-col');
+  const kpis = d.querySelectorAll('.tw-kpi');
+
+  // Đây là khẳng định quan trọng nhất: HTTP 200 + thẻ 0 = trang trắng.
+  assert(cards.length > 0, 'bảng có thẻ việc (không rỗng)', `${cards.length} thẻ`);
+  assert(cols.length === 4, 'có đủ 4 cột', `${cols.length} cột`);
+  assert(kpis.length === 4, 'có đủ 4 ô KPI', `${kpis.length} ô`);
+
+  const countText = d.querySelector('#tw-count').textContent;
+  assert(/\d+\s*\/\s*\d+\s*việc/.test(countText), 'dòng đếm việc có dạng "n / m việc"', countText);
+
+  const titles = [...cards].map((c) => c.querySelector('.tw-card-title').textContent);
+  assert(titles.every((t) => t && t.trim().length > 0), 'mọi thẻ có tiêu đề');
+  assert(!titles.some((t) => t.includes('undefined')), 'không thẻ nào chứa "undefined"');
+
+  // Tiêu đề phải KHÁC NHAU trong cùng một cột. Bản đầu lấy tiêu đề ADR làm tiêu
+  // đề thẻ ⇒ 5 câu hỏi của ADR-0044 là 5 thẻ giống hệt, và 14 thẻ "chưa đo" đều
+  // ghi "Chưa đo / chưa chạy kiểm tra này". Bảng đầy mà không đọc được gì.
+  for (const col of d.querySelectorAll('.tw-col')) {
+    const ts = [...col.querySelectorAll('.tw-card-title')].map((x) => x.textContent);
+    const dupes = ts.filter((t, i) => ts.indexOf(t) !== i);
+    assert(dupes.length === 0, `tiêu đề trong cột "${col.querySelector('.tw-chip').textContent}" không trùng nhau`,
+      `${dupes.length} trùng, vd: ${dupes[0]}`);
+  }
+
+  // Mỗi loại thẻ phải nói được nội dung riêng của nó, không chỉ nhãn loại.
+  const qCard = d.querySelector('.tw-card .tw-card-title');
+  assert(!/^Chưa đo \/ chưa chạy kiểm tra này$/.test(qCard.textContent),
+    'thẻ "chưa đo" nêu nội dung cụ thể, không dùng câu chung');
+
+  /* ------------------------------ 2b. TRƯỜNG SUY RA phải trung thực -------- */
+
+  /*
+   * Trang /tasks mượn khuôn Jira, nên trên thẻ có bốn ô mà Jira có: ưu tiên,
+   * điểm, người, hoạt động. Rủi ro lớn nhất của việc mượn khuôn là **ô có mà
+   * dữ liệu không có thật** — trông đúng nhưng bịa.
+   *
+   * Nên ở đây kiểm cả hai chiều:
+   *   1. Ô nào cũng phải có giá trị suy ra được từ tài liệu, không phải hằng số.
+   *   2. Ô "không có dữ liệu" phải HIỆN là không có, không được mang giá trị giả.
+   */
+  {
+    const items = data.WORK_ITEMS;
+
+    // (a) mọi item phải có priority.level thuộc bốn mức, và priority.why không rỗng
+    const LEVELS = ['Critical', 'High', 'Medium', 'Low'];
+    const badPri = items.filter((i) => !i.priority || !LEVELS.includes(i.priority.level)
+      || !i.priority.why || !i.priority.why.trim());
+    assert(badPri.length === 0, 'mọi ADR có priority.level hợp lệ + priority.why', badPri.map((i) => i.id).join(','));
+
+    // (b) KHÔNG ưu tiên nào được suy ra từ hằng số: phải có ít nhất hai mức khác
+    //     nhau. Nếu mọi thứ cùng một mức thì "suy ra" thực chất là gán cứng.
+    const lv = new Set(items.map((i) => i.priority && i.priority.level));
+    assert(lv.size >= 2, 'ưu tiên phân hoá thật, không phải một hằng số', [...lv].join(','));
+
+    // (c) Critical PHẢI tương ứng có chữ "blocking" trong ADR — không được
+    //     nâng mức mà tài liệu không nói. Đây là kiểm chống thổi phồng.
+    const critNoBlock = items.filter((i) => i.priority?.level === 'Critical' && !i.blocking);
+    assert(critNoBlock.length === 0, 'Critical chỉ khi tài liệu tự khai blocking',
+      critNoBlock.map((i) => i.id).join(','));
+    const blockNotCrit = items.filter((i) => i.blocking && i.priority?.level !== 'Critical');
+    assert(blockNotCrit.length === 0, 'có "blocking" thì phải Critical',
+      blockNotCrit.map((i) => i.id).join(','));
+
+    // (d) points phải bằng weight — nếu khác thì con số trên thẻ không còn là
+    //     "số thứ còn mở" mà nhãn nói.
+    const badPts = items.filter((i) => i.points !== i.weight);
+    assert(badPts.length === 0, 'points = weight (nhãn "mở" nói đúng thứ nó đếm)',
+      badPts.map((i) => i.id).join(','));
+
+    // (e) assignee: nếu CÓ thì phải là chuỗi thật; nếu KHÔNG thì phải là null —
+    //     không được là "undefined", "N/A", "-" hay chuỗi rỗng.
+    /*
+     * "Không có dữ liệu" phải là `null` — KHÔNG được là một chuỗi trông như dữ
+     * liệu. Lần chứng minh đỏ đầu tiên của tôi đổi `null` thành `"N/A"` và cổng
+     * vẫn xanh, vì lúc đó chỉ kiểm "không phải chuỗi rỗng". `"N/A"` chính là
+     * kiểu giá trị tệ nhất trong một ô kiểu Jira: nó chiếm chỗ của dữ liệu thật
+     * và trông như đã được điền. Nên chặn cả danh sách giá trị giả.
+     */
+    const PLACEHOLDERS = new Set(['n/a', 'na', '-', '—', '?', 'none', 'null', 'undefined', 'tbd', 'chưa có', 'chưa ghi']);
+    const badAs = items.filter((i) => {
+      if (i.assignee === null) return false;
+      if (typeof i.assignee !== 'string' || !i.assignee.trim()) return true;
+      return PLACEHOLDERS.has(i.assignee.trim().toLowerCase());
+    });
+    assert(badAs.length === 0,
+      'assignee là null hoặc tên thật — không rỗng, không "N/A", không "—"',
+      badAs.slice(0, 3).map((i) => `${i.id}=${JSON.stringify(i.assignee)}`).join(', '));
+    const known = items.filter((i) => i.assignee).length;
+    assert(known > 0, 'có ít nhất một ADR ghi người quyết', `${known}/${items.length}`);
+
+    // (f) Trên DOM: thẻ của ADR KHÔNG có người quyết phải hiện ô "?" (chỗ trống
+    //     đã biết), không được hiện một avatar tên giả.
+    const unknown = items.find((i) => !i.assignee);
+    if (unknown) {
+      const av = d.querySelector('.tw-assignee.none');
+      assert(!!av, 'ADR không ghi người quyết ⇒ thẻ hiện ô "?" (nét đứt)');
+    }
+
+    // (g) Nhãn trên thẻ phải khớp dữ liệu: số "mở" hiển thị = weight.
+    const firstCard = d.querySelector('.tw-card');
+    const ptText = firstCard.querySelector('.tw-pt')?.textContent || '';
+    assert(/^\d+ mở$/.test(ptText.trim()), 'chân thẻ có số việc dạng "n mở"', ptText.trim());
+
+    // (h) Lọc theo ưu tiên phải thu hẹp thật, và Critical-phải-lọc-được.
+    const sel = d.querySelector('#tw-priority');
+    assert(!!sel, 'có bộ lọc ưu tiên');
+    if (sel) {
+      const total = d.querySelectorAll('.tw-card').length;
+      sel.value = 'Critical';
+      sel.dispatchEvent(new window.Event('change', { bubbles: true }));
+      const after = d.querySelectorAll('.tw-card').length;
+      assert(after > 0 && after < total, 'lọc "Critical" thu hẹp danh sách', `${after} / ${total}`);
+      // Mọi thẻ còn lại phải thật sự là Critical
+      const labels = [...d.querySelectorAll('.tw-card .tw-pri')].map((x) => x.textContent.trim());
+      assert(labels.every((x) => x === 'Critical'), 'sau khi lọc, mọi thẻ đều là Critical',
+        [...new Set(labels)].join(','));
+      sel.value = '';
+      sel.dispatchEvent(new window.Event('change', { bubbles: true }));
+      assert(d.querySelectorAll('.tw-card').length === total, 'bỏ lọc ưu tiên trả lại đủ thẻ');
+    }
+  }
+
+  /* ------------------------------------------------- 3. bộ lọc thật sự lọc */
+
+  const total = cards.length;
+  const sel = d.querySelector('#tw-kind');
+  sel.value = 'question';
+  sel.dispatchEvent(new window.Event('change'));
+  const afterKind = d.querySelectorAll('.tw-card').length;
+  assert(afterKind > 0 && afterKind < total, 'lọc "câu hỏi" thu hẹp danh sách',
+    `${total} → ${afterKind}`);
+
+  sel.value = '';
+  sel.dispatchEvent(new window.Event('change'));
+  assert(d.querySelectorAll('.tw-card').length === total, 'bỏ lọc trả lại đủ số thẻ');
+
+  const search = d.querySelector('#tw-search');
+  search.value = 'ADR-0043';
+  search.dispatchEvent(new window.Event('input'));
+  const afterSearch = d.querySelectorAll('.tw-card').length;
+  assert(afterSearch > 0 && afterSearch < total, 'tìm "ADR-0043" lọc được',
+    `${total} → ${afterSearch}`);
+
+  search.value = 'zzz-khong-ton-tai';
+  search.dispatchEvent(new window.Event('input'));
+  assert(d.querySelectorAll('.tw-card').length === 0, 'từ khoá không khớp ⇒ 0 thẻ');
+  assert(d.querySelector('.tw-empty'), 'có thông báo rỗng thay vì khoảng trắng');
+
+  search.value = '';
+  search.dispatchEvent(new window.Event('input'));
+
+  /* --------------------------------------------------- 4. drawer mở được */
+
+  const first = d.querySelector('.tw-card');
+  assert(first !== null, 'có ít nhất một thẻ để bấm (trước khi kiểm drawer)');
+  if (first) first.dispatchEvent(new window.Event('click'));
+  assert(d.querySelector('#tw-drawer').hidden === false, 'bấm thẻ ⇒ mở drawer');
+  const drawerText = d.querySelector('#tw-d-body').textContent;
+  assert(drawerText.includes('Nguồn'), 'drawer có mục Nguồn');
+  assert(drawerText.includes('không làm gì') || drawerText.includes('Không đổi trạng thái'),
+    'drawer nói rõ trang này không đổi được gì');
+
+  d.querySelector('#tw-d-close').dispatchEvent(new window.Event('click'));
+  assert(d.querySelector('#tw-drawer').hidden === true, 'nút ✕ đóng drawer (thuộc tính hidden)');
+
+  /*
+   * Nhưng `hidden === true` KHÔNG chứng minh người dùng thấy drawer đóng — đó
+   * đúng là lỗi đã xảy ra (ảnh Console 2026-11-24): nút ✕ chạy đúng, `hidden`
+   * thành true, mà drawer vẫn hiện vì `.tw-drawer { display: flex }` ghi đè
+   * `display: none` của thuộc tính `hidden`.
+   *
+   * jsdom không có layout engine nên không thể "nhìn". Nhưng nó ĐỌC ĐƯỢC CSS,
+   * và cái cần kiểm là một sự thật tĩnh: **có rule tác giả nào làm `hidden`
+   * mất hiệu lực không**. Nên ta tải chính `tasks.css` thật rồi kiểm.
+   */
+  const cssUrl = assetUrls.find((u) => u.endsWith('.css'));
+  const css = await (await fetch(base + cssUrl)).text();
+
+  /**
+   * Áp luật CSS theo thứ tự khai báo (luật sau thắng khi cùng độ ưu tiên) và trả
+   * `display` hiệu dụng của phần tử. Chỉ xử lý đúng hai dạng cần dùng: selector
+   * đơn giản `.cls` và `[hidden]`, có/không `!important`.
+   *
+   * Giới hạn phải nói rõ: đây KHÔNG phải CSS engine. Nó đủ để bắt đúng lớp lỗi
+   * này (một khai báo `display` ở tác giả đè lên `hidden`), không đủ để kiểm
+   * layout, kế thừa, media query.
+   */
+  function effectiveDisplay(cssText, className, isHidden) {
+    const decls = [];
+    // BÓC CHÚ THÍCH TRƯỚC. Không bóc thì selector của rule đầu tiên sau một
+    // chú thích dính nguyên khối `/* ... */` phía trước, và `[hidden]` không bao
+    // giờ khớp — cổng báo đỏ chính CSS đã sửa đúng.
+    const clean = cssText.replace(/\/\*[\s\S]*?\*\//g, '');
+    const ruleRe = /([^{}]+)\{([^{}]*)\}/g;
+    for (const m of clean.matchAll(ruleRe)) {
+      const sel = m[1].trim();
+      const body = m[2];
+      const d = body.match(/display\s*:\s*([a-z-]+)\s*(!important)?/);
+      if (!d) continue;
+      let hits = 0;
+      let power = 0;
+      for (const part of sel.split(',').map((x) => x.trim())) {
+        if (part === '.\u002a') continue;
+        if (/^\.[\w-]+$/.test(part) && part.slice(1) === className) { hits++; power = 1; }
+        if (part === '[hidden]' && isHidden) { hits++; power = 2; }
+        if (/^\.[\w-]+\[hidden\]$/.test(part) && part.slice(1, part.indexOf('[')) === className && isHidden) {
+          hits++; power = 2;
+        }
+      }
+      if (!hits) continue;
+      decls.push({ value: d[1], important: !!d[2], power });
+    }
+    if (!decls.length) return isHidden ? 'none' : 'block';
+    // `!important` thắng; trong cùng mức đó, selector đặc thù hơn rồi tới khai
+    // báo sau. `[hidden]` KHÔNG có `!important` mà đấu với `display:flex` của
+    // tác giả thì THUA — đó chính là lỗi.
+    decls.sort((a, b) => (Number(a.important) - Number(b.important)) || (a.power - b.power));
+    return decls[decls.length - 1].value;
+  }
+
+  for (const cls of ['tw-drawer', 'tw-drawer-back']) {
+    // Ở trạng thái đóng, phần tử mang cả class lẫn thuộc tính `hidden`.
+    const shown = effectiveDisplay(css, cls, true);
+    assert(shown === 'none',
+      `.${cls}[hidden] phải có display:none — nếu không, đóng drawer KHÔNG có tác dụng thị giác`,
+      `display hiệu dụng: ${shown} (cần rule [hidden]{display:none!important})`);
+  }
+
+  // Và ở trạng thái mở, nó phải hiện thật (không bị rule khác vô hiệu hoá).
+  const openDisp = effectiveDisplay(css, 'tw-drawer', false);
+  assert(openDisp !== 'none', '.tw-drawer khi MỞ phải có display khác none', openDisp);
+
+  /* ------------------------------------- 5. ranh giới: trang không gọi API */
+
+  // Bóc chú thích TRƯỚC khi kiểm. Kiểm chữ thô trên cả tệp bắt được `/api/` nằm
+  // trong một câu chú thích giải thích vì sao trang không gọi API — false positive
+  // đúng loại đã mắc hai lần trong hôm nay. Kiểm mã, không kiểm lời bình.
+  const codeOnly = js
+    .replace(/\/\*[\s\S]*?\*\//g, '')
+    .replace(/(^|[^:])\/\/.*$/gm, '$1');
+  assert(!/\bfetch\s*\(/.test(codeOnly), 'tasks.js không gọi mạng — bảng là bản chiếu của repo');
+  assert(!/['"`]\/api\//.test(codeOnly), 'tasks.js không gọi /api/');
+} catch (e) {
+  bad('luồng kiểm chạy hết không ném lỗi', e.message);
+} finally {
+  srv.kill('SIGKILL');
+}
+
+/* ------------------------------------------------------------------ report */
+
+const fails = results.filter((r) => !r.ok);
+for (const f of fails) console.log(`  ❌ ${f.name}${f.why ? ` — ${f.why}` : ''}`);
+if (fails.length) {
+  console.log(`\n## ❌ ${fails.length}/${results.length} kiểm tra THẤT BẠI — trang /tasks`);
+  process.exit(1);
+}
+console.log(`## ✅ ${results.length}/${results.length} kiểm tra đạt — trang /tasks render đúng`);
