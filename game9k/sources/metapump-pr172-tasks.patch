+/**
+ * tasks.js — bảng việc đọc từ repo, bố cục theo khuôn Jira.
+ *
+ * Dữ liệu đến từ `portal/public/work-items.generated.mjs`, sinh bởi
+ * `scripts/extract_work_items.mjs`. Trang KHÔNG gọi API, KHÔNG tạo việc,
+ * KHÔNG sửa tài liệu. Nó chỉ hiển thị thứ đã có trong repo.
+ *
+ * ## Vì sao mượn khuôn Jira mà không phải Jira
+ *
+ * Người đọc trang này là nhà đầu tư. `Priority / Points / Assignee / Activity`
+ * là bốn thứ họ đã thấy ở mọi công cụ quản lý dự án, nên bố cục đó đọc được
+ * ngay, không phải học. Nhưng **nội dung** của bốn ô đó ở đây khác Jira:
+ *
+ * | Ô | Jira | Trang này |
+ * |---|---|---|
+ * | Priority | người ta tự gán | **suy ra** từ tài liệu (có mục "blocking" ⇒ Critical), kèm lý do |
+ * | Points | ước lượng công sức | **đếm** số thứ còn chưa đóng — không phải ước lượng |
+ * | Assignee | người làm | người **chịu trách nhiệm quyết**, đọc từ `**Người quyết:**` |
+ * | Activity | nhật ký thao tác | **chỉ** mốc có thật: ngày trong header. Không bịa lịch sử |
+ *
+ * Không ô nào được điền bằng dữ liệu mô phỏng. Ô nào không có dữ liệu thì hiện
+ * "không có dữ liệu", không hiện một giá trị trông như thật — đó là ranh giới
+ * `ADR-0044` §0 và `ADR-0042` §6 đã đặt.
+ *
+ * ## Khuôn thị giác
+ *
+ * Ô xem trước: `lexuankhanh1612/v0-jira-clone` (fork của `dilums/v0-jira-clone`)
+ * — **license `null` ở cả fork và gốc**. Vì vậy trang này chỉ học **bố cục**
+ * (cột theo trạng thái, thẻ có mã + ưu tiên + người + điểm, drawer chi tiết có
+ * tab Description/Activity). **Không một tệp, không một dòng CSS, không một
+ * component nào** được chép từ đó. Toàn bộ mã dưới đây viết mới trong khuôn
+ * mẫu sẵn có của repo này (`tw-` prefix, cùng biến CSS của `tasks.css`).
+ */
+
+import { WORK_ITEMS, WORK_STATS } from '/assets/work-items.generated.mjs';
+
+const $ = (s) => document.querySelector(s);
+const $$ = (s) => Array.from(document.querySelectorAll(s));
+
+/** Nhãn tiếng Việt cho từng loại việc. */
+const KIND = {
+  decision: { label: 'Chờ ký quyết định', short: 'Chờ ký', cls: 'warn' },
+  question: { label: 'Câu hỏi chưa trả lời', short: 'Câu hỏi', cls: 'bad' },
+  scope: { label: 'Ngoài phạm vi (có chủ đích)', short: 'Ngoài phạm vi', cls: 'muted' },
+  measure: { label: 'Chưa đo được', short: 'Chưa đo', cls: 'info' },
+};
+
+/**
+ * Cột bảng việc — theo trạng thái, giống Kanban.
+ *
+ * KHÁC Jira ở một điểm có chủ đích: không có cột "Done". Việc ở đây là *thứ
+ * còn tồn*; một khi đã xong thì nó biến khỏi tài liệu nguồn và biến khỏi bảng.
+ * Giữ một cột "Done" rỗng là bịa ra cảm giác tiến độ.
+ */
+const COLUMNS = [
+  { kind: 'decision', hint: 'ADR chưa được PO ký' },
+  { kind: 'question', hint: 'có mã Q-…, chưa có câu trả lời trong repo' },
+  { kind: 'measure', hint: 'tài liệu tự khai "chưa đo / chưa chạy"' },
+  { kind: 'scope', hint: 'bỏ có chủ đích, không phải bỏ quên' },
+];
+
+const PRIORITY_CLS = { Critical: 'crit', High: 'high', Medium: 'med', Low: 'low' };
+
+const state = { q: '', status: '', kind: '', priority: '' };
+
+function esc(s) {
+  return String(s == null ? '' : s)
+    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+/**
+ * Một ADR ⇒ nhiều thẻ việc. Mỗi thẻ mang theo bốn trường suy ra của ADR cha.
+ *
+ * `weight` (đã có sẵn từ extractor) dùng làm số "việc còn mở" trên thẻ — nhãn
+ * nói rõ đó là **số thứ chưa đóng**, không phải điểm ước lượng công sức. Điểm
+ * ước lượng trên một bảng việc đọc từ tài liệu là con số không ai đo.
+ */
+function toTasks() {
+  const out = [];
+  for (const adr of WORK_ITEMS) {
+    const base = {
+      adr,
+      priority: adr.priority || { level: 'Low', why: 'không suy ra được' },
+      points: adr.points,
+      assignee: adr.assignee,
+      updatedAt: adr.updatedAt,
+    };
+
+    if (adr.open) {
+      out.push({
+        ...base,
+        kind: 'decision',
+        id: `${adr.id} · ký`,
+        title: adr.title,
+        body: adr.shortAnswer || adr.status,
+        meta: adr.status,
+      });
+    }
+    for (const q of adr.questions) {
+      // `title` là CÂU HỎI, không phải tiêu đề ADR. Bản đầu để tiêu đề ADR ⇒
+      // năm câu hỏi của ADR-0044 hiện ra như năm thẻ giống hệt nhau.
+      out.push({ ...base, kind: 'question', id: q.id, title: q.text, body: adr.title, meta: q.id });
+    }
+    for (const o of adr.outOfScope) {
+      out.push({
+        ...base,
+        kind: 'scope',
+        id: `${adr.id} · ngoài phạm vi`,
+        title: o.what,
+        body: o.why,
+        meta: o.owner ? `người quyết: ${o.owner}` : 'chưa ghi người quyết',
+      });
+    }
+    for (const [i, u] of adr.unmeasured.entries()) {
+      // Tiêu đề chung chung "chưa đo" không nói được CHƯA ĐO CÁI GÌ.
+      out.push({ ...base, kind: 'measure', id: `${adr.id} · đo ${i + 1}`, title: u, body: adr.title, meta: adr.id });
+    }
+  }
+  return out;
+}
+
+const TASKS = toTasks();
+
+function matches(t) {
+  if (state.status === 'open' && !t.adr.open) return false;
+  if (state.status === 'accepted' && t.adr.open) return false;
+  if (state.kind && t.kind !== state.kind) return false;
+  if (state.priority && t.priority.level !== state.priority) return false;
+  if (!state.q) return true;
+  const hay = `${t.id} ${t.title} ${t.body} ${t.adr.id} ${t.adr.title} ${t.assignee || ''}`.toLowerCase();
+  return hay.includes(state.q.toLowerCase());
+}
+
+function renderKpis() {
+  const s = WORK_STATS;
+  const cards = [
+    { l: 'Việc đang mở', v: TASKS.filter((t) => t.kind !== 'scope').length, f: `${s.adrOpen} ADR chưa ký` },
+    { l: 'Chặn tiến độ', v: s.blocking, f: 'tài liệu tự khai "blocking"' },
+    { l: 'Câu hỏi chưa trả lời', v: s.adrQuestions, f: 'có mã Q-…, chưa trả lời' },
+    { l: 'Chưa đo được', v: s.unmeasured, f: 'tự khai "chưa đo / chưa chạy"' },
+  ];
+  $('#tw-kpis').innerHTML = cards.map((c) => `
+    <div class="tw-kpi">
+      <div class="tw-kpi-label">${esc(c.l)}</div>
+      <div class="tw-kpi-value">${esc(c.v)}</div>
+      <div class="tw-kpi-foot">${esc(c.f)}</div>
+    </div>`).join('');
+}
+
+function renderBoard() {
+  const shown = TASKS.filter(matches);
+  $('#tw-count').textContent = `${shown.length} / ${TASKS.length} việc`;
+
+  $('#tw-board').innerHTML = COLUMNS.map(({ kind, hint }) => {
+    const items = shown.filter((t) => t.kind === kind);
+    const label = KIND[kind];
+    return `
+      <div class="tw-col" data-col="${kind}">
+        <div class="tw-col-head">
+          <div>
+            <span class="tw-chip ${label.cls}">${esc(label.label)}</span>
+            <div class="tw-col-hint">${esc(hint)}</div>
+          </div>
+          <span class="tw-col-n">${items.length}</span>
+        </div>
+        <div class="tw-col-body">
+          ${items.length ? items.map(card).join('')
+    : '<div class="tw-empty">Không có việc nào khớp bộ lọc.</div>'}
+        </div>
+      </div>`;
+  }).join('');
+
+  $$('[data-task]').forEach((el) => {
+    el.addEventListener('click', (e) => {
+      // Bấm vào link nguồn trong thẻ thì đi tới GitHub, không mở drawer.
+      if (e.target.closest('a')) return;
+      openDrawer(el.dataset.task);
+    });
+    el.addEventListener('keydown', (e) => {
+      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDrawer(el.dataset.task); }
+    });
+  });
+}
+
+/** Một thẻ việc: mã + ưu tiên ở trên, tiêu đề, rồi hàng chân kiểu Jira. */
+function card(t) {
+  const key = encodeURIComponent(`${t.kind}|${t.id}`);
+  const p = t.priority;
+  return `
+    <article class="tw-card" data-task="${key}" tabindex="0" role="button">
+      <div class="tw-card-top">
+        <span class="tw-code">${esc(t.id)}</span>
+        <span class="tw-pri ${PRIORITY_CLS[p.level] || 'low'}" title="${esc(p.why)}">${esc(p.level)}</span>
+      </div>
+      <div class="tw-card-title">${esc(t.title)}</div>
+      <div class="tw-card-body">${esc(t.body)}</div>
+      <div class="tw-card-foot">
+        <span class="tw-pt" title="Số thứ còn chưa đóng — không phải điểm ước lượng">${esc(t.points)} mở</span>
+        ${t.assignee
+    ? `<span class="tw-assignee" title="Người chịu trách nhiệm QUYẾT, không phải người làm">${esc(initials(t.assignee))}</span>`
+    : '<span class="tw-assignee none" title="ADR viết trước mẫu — header không có dòng Người quyết">?</span>'}
+        <span class="tw-spacer"></span>
+        <a href="${esc(t.adr.href)}" target="_blank" rel="noopener" class="tw-src">${esc(t.adr.id)} ↗</a>
+      </div>
+    </article>`;
+}
+
+/** Chữ viết tắt cho avatar: "Project Owner (Lê Xuân Khánh)" ⇒ "PO". */
+function initials(name) {
+  const beforeParen = name.split('(')[0].trim();
+  const words = beforeParen.split(/\s+/).filter(Boolean);
+  if (words.length >= 2) return words.map((w) => w[0]).join('').slice(0, 3).toUpperCase();
+  return beforeParen.slice(0, 2).toUpperCase();
+}
+
+function openDrawer(key) {
