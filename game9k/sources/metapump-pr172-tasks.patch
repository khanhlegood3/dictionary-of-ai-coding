+/**
+ * Test cho bộ trích xuất bảng việc.
+ *
+ * Vì sao cần test riêng, ngoài `check_work_items_sync.py`: cổng đó chỉ so **bản
+ * sinh có khớp tệp đã commit** — nó không biết vì sao bản sinh đúng. Bộ sinh đã
+ * từng đọc 25/43 ADR và báo 0/48 câu hỏi mà **mọi cổng vẫn xanh**, vì bản sinh
+ * khớp chính nó. Test này kiểm từng hàm bóc tách trên chuỗi dựng sẵn.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+
+import {
+  collect, statusOf, titleOf, questionsOf, outOfScopeOf, isAccepted,
+} from '../../scripts/extract_work_items.mjs';
+
+const ROOT = path.resolve(import.meta.dirname, '../..');
+
+test('statusOf đọc được CẢ BA kiểu viết trạng thái trong repo', () => {
+  // (a) kiểu ADR từ 0027
+  assert.equal(statusOf('**Trạng thái:** Accepted\n'), 'Accepted');
+  // (b) kiểu danh sách — ADR-0034
+  assert.equal(statusOf('- **Trạng thái:** Proposed\n'), 'Proposed');
+  // (c) kiểu BẢNG — ADR-0001…0026. Bản đầu bỏ sót kiểu này ⇒ mất 17 ADR.
+  assert.equal(statusOf('| **Trạng thái** | Accepted |\n'), 'Accepted');
+  // Không có trạng thái ⇒ chuỗi rỗng, KHÔNG đoán.
+  assert.equal(statusOf('# ADR không có dòng trạng thái\n'), '');
+});
+
+test('isAccepted: "Accepted cho §3" vẫn còn mở nếu có Proposed', () => {
+  assert.equal(isAccepted('Accepted'), true);
+  assert.equal(isAccepted('Proposed — chờ PO ký'), false);
+  // ADR-0041: "Proposed — một phần đã cài" ⇒ CÒN MỞ, dù có chữ "đã cài".
+  assert.equal(isAccepted('Proposed — một phần **đã cài** (§6)'), false);
+  // ADR-0038: "Accepted cho §3" ⇒ đóng (không có Proposed).
+  assert.equal(isAccepted('**Accepted** cho §3 (PO quyết 2026-11-23)'), true);
+  // Cả hai ⇒ coi là CHƯA đóng: an toàn hơn là đánh dấu xong nhầm.
+  assert.equal(isAccepted('Accepted một phần, Proposed phần còn lại'), false);
+});
+
+test('titleOf đọc được ba kiểu phân cách, và lấy mã từ TÊN TỆP khi tiêu đề thiếu', () => {
+  assert.deepEqual(
+    titleOf('# ADR-0001 — Tên có gạch dài\n', 'ADR-0001-x.md'),
+    { id: 'ADR-0001', title: 'Tên có gạch dài' },
+  );
+  assert.deepEqual(
+    titleOf('# ADR-0027 · Tên có dấu chấm giữa\n', 'ADR-0027-x.md'),
+    { id: 'ADR-0027', title: 'Tên có dấu chấm giữa' },
+  );
+  // Tiêu đề không có mã ⇒ dùng tên tệp. Bản đầu trả null ⇒ mất 18 ADR.
+  assert.deepEqual(
+    titleOf('# Bảng quyết định không ghi số\n', 'ADR-0012-modular-monolith.md'),
+    { id: 'ADR-0012', title: 'Bảng quyết định không ghi số' },
+  );
+});
+
+test('questionsOf khớp cả bốn biến thể mã câu hỏi', () => {
+  const mk = (id) => `| **${id}** | Câu hỏi gì đó đủ dài |\n`;
+  // ADR-0043 dùng dạng bỏ số 0; ADR-0031 cũng vậy. Thử cả dạng có/không gạch.
+  for (const id of ['Q-ADR43-a', 'Q-ADR-43-a', 'Q-ADR0043-a', 'Q-ADR-0043-a']) {
+    const got = questionsOf(mk(id), 'ADR-0043');
+    assert.equal(got.length, 1, `không khớp biến thể ${id}`);
+    assert.equal(got[0].id, id);
+  }
+  // Mã của ADR khác KHÔNG được lọt vào.
+  assert.equal(questionsOf(mk('Q-ADR44-a'), 'ADR-0043').length, 0);
+});
+
+test('outOfScopeOf đọc bảng ngoài phạm vi, và BỎ QUA bảng số liệu', () => {
+  const md = `## 4. Điều ADR này **KHÔNG** bao gồm
+
+| Không bao gồm | Vì sao | Ai quyết |
+|---|---|---|
+| Bật thanh toán thật | REQ-M5-009 cấm fiat | PO |
+| Webhook | chưa có endpoint | — |
+
+## 5. Bảng đo
+
+| Số viên | Thời gian |
+|---|---|
+| 4 | 15,9 ms |
+| 32 | 19,0 ms |
+`;
+  const rows = outOfScopeOf(md);
+  assert.equal(rows.length, 2, 'phải chỉ có 2 dòng ngoài phạm vi');
+  assert.equal(rows[0].what, 'Bật thanh toán thật');
+  assert.equal(rows[0].owner, 'PO');
+  // Bảng benchmark ở §5 KHÔNG phải "việc không làm" — đọc sai sẽ biến số đo
+  // thành quyết định, đúng lỗi đã mắc.
+  assert.ok(!rows.some((r) => /15,9|19,0/.test(r.what + r.why)));
+});
+
+test('collect(): đọc ĐỦ tệp ADR, không bỏ sót im lặng', () => {
+  const { items, stats } = collect();
+  const adrFiles = fs.readdirSync(path.join(ROOT, 'docs', '08-adr'))
+    .filter((f) => /^ADR-\d{4}.*\.md$/.test(f));
+  assert.equal(stats.adrTotal, adrFiles.length, 'adrTotal phải bằng số tệp ADR');
+  assert.ok(stats.adrOpen > 0, 'phải có ADR còn mở');
+  assert.ok(stats.adrQuestions > 0,
+    'phải đếm được câu hỏi — bản từng báo 0 trong khi tài liệu có 48');
+  assert.ok(stats.unmeasured > 0, 'phải thấy dòng "chưa đo"');
+
+  // Mọi item phải có href trỏ tới tệp thật, không phải link chết.
+  for (const it of items) {
+    const m = it.href.match(/docs\/08-adr\/(.+)$/);
+    assert.ok(m && fs.existsSync(path.join(ROOT, 'docs', '08-adr', m[1])),
