+#!/usr/bin/env node
+/**
+ * extract_work_items.mjs — gom việc còn TỒN từ tài liệu thành dữ liệu hiển thị được.
+ *
+ * ## Vì sao phải "sinh", không đọc lúc chạy
+ *
+ * `.vercelignore` **không upload `docs/`** — portal trên production không thể
+ * `readFileSync("docs/08-adr/…")`. Cùng lý do và cùng cách xử lý như
+ * `gen_portal_data.mjs` (ADR-0031): **sinh** một bản rút gọn lúc build, commit
+ * kết quả, và để CI `--check` chặn bản trôi.
+ *
+ * ## Vì sao script này KHÔNG sinh ra "issue"
+ *
+ * Ranh giới quan trọng, không phải chi tiết kỹ thuật:
+ *
+ *   • **Việc còn tồn = thứ đã có trong repo** (ADR `Proposed`, câu hỏi `Q-…`,
+ *     mục "KHÔNG bao gồm", dòng "CHƯA ĐO"). Đây là **sự thật đọc được**, nên
+ *     được hiển thị công khai cho nhà đầu tư xem.
+ *   • **Issue = thứ có người CHỊU TRÁCH NHIỆM** (assignee, hạn, vòng đời).
+ *     GitHub là nguồn chính (Nguyên tắc 04). Script này **không** tạo issue,
+ *     không đẩy gì lên GitHub. Muốn thành issue thì người bấm tạo.
+ *
+ * Trộn hai thứ đó là cách nhanh nhất để có "bảng việc" trông đầy mà không ai
+ * chịu trách nhiệm — đúng kiểu dashboard dối mà repo này đang tránh.
+ *
+ * ## Chỉ đọc đúng BA loại tín hiệu, không suy diễn thêm
+ *
+ *   1. `ADR-*`: trạng thái chưa `Accepted` ⇒ còn tồn; trích luôn §0 (quyết định
+ *      một dòng), danh sách `Q-ADRNN-x` chưa trả lời, và bảng ngoài phạm vi.
+ *   2. `Q-NN` trong `docs/12-decisions/` ⇒ câu hỏi còn mở (đếm, không đoán nội dung).
+ *   3. Dòng có `CHƯA ĐO` / `chưa chạy` trong ADR ⇒ việc *đo* còn tồn.
+ *
+ * Mọi thứ khác trong repo **không** được biến thành "task" ở đây. Nếu một việc
+ * muốn xuất hiện trên bảng, nó phải được viết thành ADR/question trong repo —
+ * đúng luật "bảng việc đọc từ repo, không nhập tay".
+ *
+ * ## Dùng
+ *
+ *   node scripts/extract_work_items.mjs           # ghi
+ *   node scripts/extract_work_items.mjs --check   # exit 1 nếu đã trôi
+ *
+ * @see docs/08-adr/ADR-0044-bang-viec-doc-tu-repo.md
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const ADR_DIR = path.join(ROOT, 'docs', '08-adr');
+const DECISION_DIR = path.join(ROOT, 'docs', '12-decisions');
+// Đặt trong `portal/public/` — KHÔNG phải `portal/lib/`. Trình duyệt không đọc
+// được `portal/lib/` (server chỉ phục vụ `public/`); bản đầu để ở `lib/` nên
+// `/lib/work-items.generated.mjs` trả 404 và trang trắng, dù mọi thứ khác xanh.
+// Cùng chỗ với `portal/public/games/*.html` do `gen_portal_data.mjs` sinh.
+const OUT = path.join(ROOT, 'portal', 'public', 'work-items.generated.mjs');
+const CHECK = process.argv.includes('--check');
+
+/** Bỏ nhấn mạnh markdown để hiển thị sạch. Giữ nguyên chữ, chỉ bỏ ký hiệu. */
+function plain(s) {
+  return String(s || '')
+    .replace(/\*\*/g, '')
+    .replace(/`/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/* ------------------------------------------------------------------ đọc ADR */
+
+/**
+ * Bóc trạng thái. Repo có BA kiểu viết:
+ *   (a) `**Trạng thái:** Accepted`         — ADR từ 0027
+ *   (b) `- **Trạng thái:** Proposed`       — ADR-0034
+ *   (c) `| **Trạng thái** | Accepted |`    — ADR-0001…0026 (bảng đầu tệp)
+ *
+ * Bản đầu chỉ đọc (a)(b) ⇒ bỏ sót 17/43 ADR và tệp sinh báo "25 ADR". Con số
+ * sai mà không có gì đỏ — đúng loại lỗi tệ nhất.
+ */
+function statusOf(md) {
+  const a = md.match(/^\s*-?\s*\*\*Trạng thái:\*\*\s*(.+)$/m);
+  if (a) return a[1].trim();
+  const c = md.match(/^\|\s*\*\*Trạng thái\*\*\s*\|\s*(.+?)\s*\|$/m);
+  return c ? c[1].trim() : '';
+}
+
+/**
+ * Đóng hay chưa. ADR-0041 viết "Proposed — một phần đã cài", ADR-0038 viết
+ * "Accepted cho §3". Đọc chữ đầu sẽ đoán sai cả hai, nên luật là: có `Accepted`
+ * *và* không còn `Proposed` mới tính là đóng.
+ */
+function isAccepted(status) {
+  return /\bAccepted\b/.test(status) && !/\bProposed\b/.test(status);
+}
+
+/**
+ * Bóc tiêu đề. Ba kiểu phân cách đang tồn tại: `ADR-0001 — Tên`, `ADR-0027 · Tên`,
+ * `ADR-0027: Tên`. Chỉ nhận gạch dài ⇒ bỏ sót 18 ADR. Mã ADR lấy từ TÊN TỆP khi
+ * tiêu đề không có, vì tên tệp là nguồn chắc chắn hơn.
+ */
+function titleOf(md, filename) {
+  const idFromFile = (filename.match(/^(ADR-\d{4})/) || [])[1] || null;
+  const m = md.match(/^#\s+(ADR-\d{4})\s*[—·:-]\s*(.+)$/m);
+  if (m) return { id: m[1], title: plain(m[2]) };
+  const h = md.match(/^#\s+(.+)$/m);
+  if (!h || !idFromFile) return null;
+  return { id: idFromFile, title: plain(h[1]) };
+}
+
+/**
+ * §0 "Trả lời ngắn". Hai kiểu đang tồn tại:
+ *   • một đoạn văn (ADR-0042)             ⇒ lấy đoạn đầu tiên
+ *   • một bảng (ADR-0043)                 ⇒ lấy dòng dữ liệu đầu tiên, ghép 3 cột
+ * Bản đầu chỉ đọc kiểu đoạn văn ⇒ ADR-0043 ra chuỗi rỗng, và bảng hiện "chưa có
+ * tóm tắt" cho đúng ADR quan trọng nhất. Đọc cả hai.
+ */
+function shortAnswerOf(md) {
+  // §0 có HAI kiểu viết, và một trong hai từng bị bỏ hẳn:
+  //   (a) đoạn văn thường  — ADR-0042
+  //   (b) **blockquote `>`** — ADR-0027…0035, 0041, 0044 (11 ADR)
+  //   (c) bảng             — ADR-0043
+  //
+  // Bản đầu lọc bỏ MỌI dòng bắt đầu bằng `>` để tránh phần trích dẫn mở đầu…
+  // và vì vậy 11 ADR có §0 là blockquote ra tóm tắt **rỗng**. Trên bảng việc,
+  // thẻ "chờ ký" của chính ADR-0044 hiện không có nội dung nào.
+  // Nay: BÓC dấu `>` rồi dùng, không vứt đi.
+  const m = md.match(/^##\s*0\.[^\n]*\n([\s\S]*?)(?=^##\s)/m);
+  if (!m) return '';
+
+  const cleaned = m[1]
+    .split('\n')
+    .map((l) => l.replace(/^\s*>\s?/, ''))          // bóc blockquote, không bỏ
+    .filter((l) => !l.trim().startsWith('|'))          // bảng xử lý ở nhánh dưới
+    .filter((l) => !/^\s*---\s*$/.test(l))
+    .join('\n');
+
+  const para = cleaned
+    .split(/\n\s*\n/)
+    .map((p) => p.trim())
+    .find((p) => p.length > 20);
+  if (para) return plain(para);
+
+  // (c) bảng "Vấn đề | Cách làm | Điểm kỹ thuật quyết định | …" — rất nhiều ADR
+  // dùng kiểu này, và bảng thường KHÔNG có ô tiêu đề (dòng đầu là `| | |`).
+  //
+  // Ghép NHÃN + NỘI DUNG của 2 dòng dữ liệu đầu. Chỉ lấy "ô dài nhất" thì mất
+  // nhãn, và câu tóm tắt thành một mẩu rời nghĩa.
+  const rows = [];
+  for (const line of m[1].split('\n')) {
+    if (!line.trim().startsWith('|')) continue;
+    const cells = line.split('|').slice(1, -1).map((c) => c.trim());
+    if (cells.length < 2) continue;
+    if (cells.every((c) => /^[-:\s]*$/.test(c))) continue;   // dòng kẻ
+    if (cells.every((c) => c === '')) continue;              // `| | |`
+    rows.push(cells);
+  }
+  // Dòng ĐẦU của bảng có thể là tiêu đề cột (`| # | Yêu cầu | Kết quả |`) chứ
+  // không phải dữ liệu. In nguyên nó ra thì người đọc nhận được "Yêu cầu · Kết
+  // quả" — một câu vô nghĩa trông như tóm tắt. Bỏ dòng tiêu đề.
+  const dataRows = rows.filter((cells) => {
+    const joined = plain(cells.join(' '));
+    return joined.length > 0 && !/^(#|stt|no\.?|mục)$/i.test(plain(cells[0] || ''));
+  });
+
+  // Ghép 2 dòng dữ liệu đầu thành MỘT câu, không cắt ở ô: cắt ở ranh giới ô thì
+  // tóm tắt đứt giữa câu ("Yêu cầu: "Áp Xsolla SDK vào dự án theo Poki portal
+  // SDK"" — hết, không có câu trả lời). Câu trả lời mới là thứ người đọc cần.
+  const parts = [];
+  for (const cells of dataRows.slice(0, 2)) {
+    const value = plain(cells.slice(1).join(' · '));
+    if (value.length > 8) parts.push(value);
+  }
+  if (parts.length) {
+    const joined = parts.join(' — ');
+    // KHÔNG cắt ngầm. Cắt cứng bằng `slice` làm câu đứt giữa từ mà không ai thấy
+    // — 274 ký tự (ADR-0034) bị cắt còn 237 và mất luôn vế sau.
+    // Chỉ cắt ở ranh giới TỪ, và luôn kèm dấu `…` để người đọc biết là đã cắt.
+    if (joined.length <= 320) return joined;
+    const cut = joined.slice(0, 300);
+    const lastSpace = cut.lastIndexOf(' ');
+    return `${cut.slice(0, lastSpace > 120 ? lastSpace : 300)}…`;
+  }
+  return '';
+}
+
+/**
+ * Câu hỏi `Q-ADR…` chưa trả lời.
+ *
+ * Mã KHÔNG đồng nhất giữa các ADR: `Q-ADR31-a`, `Q-ADR43-a`, và một số viết
+ * `Q-ADR-0043-a`. Thử cả bốn biến thể. Đây là lỗi im lặng đã mắc: viết đúng một
+ * biến thể ⇒ bộ đếm ra 0 và bảng hiện "không còn câu hỏi nào" trong khi có 48.
+ */
+function questionsOf(md, adrId) {
+  const num = adrId.replace(/^ADR-/, '');
+  const short = num.replace(/^0+/, '');
+  const prefixes = [...new Set([`Q-ADR-${num}`, `Q-ADR-${short}`, `Q-ADR${num}`, `Q-ADR${short}`])];
+  const found = new Map();
+  for (const pre of prefixes) {
+    const re = new RegExp(`\\*\\*(${pre}-[a-z])\\*\\*\\s*\\|\\s*(.+?)\\s*\\|`, 'g');
+    for (const m of md.matchAll(re)) {
+      if (!found.has(m[1])) found.set(m[1], plain(m[2]));
+    }
+  }
+  return [...found].map(([id, text]) => ({ id, text }));
+}
+
+/**
+ * Bảng "Điều ADR này KHÔNG bao gồm" ⇒ mỗi dòng là một việc CHỦ ĐỘNG không làm.
+ *
+ * Chỉ nhận bảng có **ô tiêu đề đúng dạng phạm vi** (Không bao gồm / Việc / Điều).
+ * Nếu không kiểm ô tiêu đề, bảng benchmark của ADR-0041 (`4 | 15,9 ms`) bị đọc
+ * thành 4 "mục ngoài phạm vi" — biến số đo thành quyết định.
+ */
+const SCOPE_HEADER = /^(Không bao gồm|Việc|Điều|What|Item|Out of scope)$/i;
+
+function outOfScopeOf(md) {
+  // Tìm tiêu đề mục ngoài phạm vi trên **chữ đã bóc markdown**, không trên markdown thô.
+  //
+  // Ba lỗi đã mắc ở đúng chỗ này, cả ba đều im lặng:
+  //   1. **Thiếu cờ `i`** — tiêu đề thật viết `KHÔNG bao gồm` (ADR-0044) và
+  //      `**không** làm` (ADR-0042); regex chữ thường bỏ sót cả hai.
+  //   2. **Lookahead thiếu nhánh "hết tệp"** — bảng ở mục cuối không có `##` theo
+  //      sau ⇒ không khớp ⇒ `m` null.
+  //   3. **Dấu nhấn mạnh nằm GIỮA cụm từ** — `**KHÔNG** bao gồm`. Ghép chuỗi thô
+  //      thì cụm `không bao gồm` không tồn tại: có `**` chen giữa. Đây là lỗi khó
+  //      thấy nhất, vì `heading.includes("bao gồm")` vẫn đúng.
+  //
+  // Cách đúng: bóc `**`/`` ` `` khỏi tiêu đề rồi mới so cụm từ.
+  const lines = md.split('\n');
+  const SCOPE_HEADING = /\b(không bao gồm|không\b.*\blàm\b|không\b.*\báp\b)/i;
+
+  let startIdx = -1;
+  for (let i = 0; i < lines.length; i++) {
+    if (!/^##\s/.test(lines[i])) continue;
+    if (SCOPE_HEADING.test(plain(lines[i]))) { startIdx = i; break; }
+  }
+  if (startIdx === -1) return [];
+
+  // Lấy thân: tới tiêu đề `##` kế tiếp, hoặc tới hết tệp.
+  const body = [];
+  for (let i = startIdx + 1; i < lines.length; i++) {
+    if (/^##\s/.test(lines[i])) break;
+    body.push(lines[i]);
+  }
+
+  const rows = [];
+  let headerSeen = false;
+  for (const line of body) {
+    if (!line.trim().startsWith('|')) continue;
+    const cells = line.split('|').slice(1, -1).map((c) => c.trim());
+    if (cells.length < 2) continue;
+    if (cells.every((c) => /^[-:\s]*$/.test(c))) continue;          // dòng kẻ bảng
+    if (!headerSeen) { headerSeen = SCOPE_HEADER.test(plain(cells[0])); continue; }
+    rows.push({
+      what: plain(cells[0]),
+      why: plain(cells[1]),
+      owner: plain(cells[2] || ''),
+    });
+  }
+  return headerSeen ? rows : [];
+}
+
+/** Dòng tự khai "chưa đo / chưa chạy / chưa kiểm" ⇒ việc đo còn tồn, kèm nguyên văn. */
+function unmeasuredOf(md) {
+  const hits = [];
+  for (const line of md.split('\n')) {
+    const t = line.trim();
+    if (!t.startsWith('-') && !t.startsWith('*')) continue;
+    if (!/CHƯA ĐO|CHƯA CHẠY|chưa chạy|chưa kiểm/i.test(t)) continue;
+    const text = plain(t.replace(/^[-*]\s*/, ''));
+    if (text.length > 24 && !hits.includes(text)) hits.push(text);
+  }
+  return hits.slice(0, 3);
+}
+
+/* ------------------------------------------------------- trường suy ra được */
+
+/*
+ * BỐN TRƯỜNG SUY RA — và một trường KHÔNG suy ra.
+ *
+ * Trang `/tasks` được làm lại theo khuôn Jira (`Status / Priority / Points /
+ * Assignee / Activity`). Nhưng repo này **không có** dữ liệu để điền vào mấy ô
+ * đó: không có cột người phụ trách, không có nhật ký thay đổi, không có điểm
+ * ước lượng. Bịa chúng ra là đúng thứ `ADR-0044` §0 từ chối và `ADR-0042` §6
+ * đã gọi tên ("dựng danh sách trông như thật rồi lệch").
+ *
+ * Nên chỉ suy ra từ **thứ tài liệu thật sự nói**, và mỗi giá trị mang theo
+ * `why` (vì sao suy ra như vậy) để người đọc kiểm lại được:
+ *
+ *   priority  ← có câu hỏi "Blocking"/"blocking" trong ADR ⇒ Critical
+ *               chưa ký (Proposed) ⇒ High · đã ký nhưng còn việc ⇒ Medium · xong ⇒ Low
+ *   points    ← `weight` đã có sẵn (số thứ còn chưa đóng). KHÔNG phải story point
+ *               ước lượng — nhãn dưới đây nói rõ "việc còn mở", không nói "độ lớn".
+ *   assignee  ← `**Người quyết:**` trong header. Đây là người **chịu trách nhiệm
+ *               quyết**, không phải người **làm**. Ghi đúng như vậy.
+ *   activity  ← các mốc có thật: ngày trong header + trạng thái hiện tại.
+ *               Không có lịch sử sửa đổi nào trong ADR ⇒ không hiển thị lịch sử.
+ */
+
+/** Ưu tiên suy ra. Trả `{ level, why }`. */
+function priorityOf(md, { open, weight }) {
+  if (/\b[Bb]locking\b/.test(md)) {
+    return { level: 'Critical', why: 'tài liệu tự khai có mục "blocking"' };
+  }
+  if (open && weight >= 6) return { level: 'High', why: `còn ${weight} thứ chưa đóng` };
+  if (open) return { level: 'Medium', why: `còn ${weight} thứ chưa đóng` };
+  if (weight > 1) return { level: 'Low', why: 'đã ký, còn việc phụ' };
+  return { level: 'Low', why: 'đã ký, không còn việc' };
+}
+
+/**
+ * Người chịu trách nhiệm QUYẾT (không phải người làm).
+ *
+ * KHÔNG chỉ tìm dòng bắt đầu bằng `**Người quyết:**`: mẫu ADR đặt `Người đề
+ * xuất` và `Người quyết` **trên cùng một dòng**, ngăn bằng `·`. Bản đầu của
+ * hàm này neo vào đầu dòng nên trả `null` cho **cả 45 ADR** — im lặng, không
+ * lỗi, và trang sẽ hiện "chưa ghi người quyết" ở mọi thẻ dù dữ liệu có đó.
+ * Nên tìm theo vị trí bất kỳ trong dòng header, không theo đầu dòng.
+ */
+function deciderOf(md) {
+  const m = md.match(/\*\*Người quyết:\*\*\s*([^\n·|]+)/);
+  if (!m) return null;
+  const v = m[1].trim().replace(/\*\*/g, '').trim();
+  return v || null;
+}
+
+/** Ngày trong header, ISO nếu có. */
+function dateOf(md) {
+  const m = md.match(/^\s*\*\*Ngày:\*\*\s*(\d{4}-\d{2}-\d{2})/m);
+  return m ? m[1] : null;
+}
+
+/* ------------------------------------------------------------- gom + đếm */
+
+function collect() {
+  const files = fs.readdirSync(ADR_DIR).filter((f) => /^ADR-\d{4}.*\.md$/.test(f)).sort();
+  const items = [];
+
+  for (const f of files) {
+    const md = fs.readFileSync(path.join(ADR_DIR, f), 'utf8');
+    const head = titleOf(md, f);
+    if (!head) continue;
+    const status = statusOf(md);
+    if (!status) continue;
+
+    const open = !isAccepted(status);
+    const questions = questionsOf(md, head.id);
+    const outOfScope = outOfScopeOf(md);
+    const unmeasured = unmeasuredOf(md);
+
+    // "Nặng" = còn nhiều thứ chưa đóng. Dùng để xếp thứ tự, KHÔNG phải điểm số.
+    const weight = (open ? 1 : 0) + questions.length + outOfScope.length + unmeasured.length;
+
+    items.push({
+      id: head.id,
+      title: head.title,
+      status: plain(status),
+      open,
+      href: `https://github.com/lexuankhanh1612/MetaPump/blob/main/docs/08-adr/${f}`,
+      shortAnswer: shortAnswerOf(md),
+      questions,
+      outOfScope,
+      unmeasured,
+      weight,
+      // Bốn trường suy ra — xem khối chú thích "TRƯỜNG SUY RA ĐƯỢC" ở trên.
+      // Mỗi trường mang `why` để người đọc kiểm lại được suy luận, thay vì tin.
+      priority: priorityOf(md, { open, weight }),
+      points: weight,
+      assignee: deciderOf(md),
+      updatedAt: dateOf(md),
+      blocking: /\b[Bb]locking\b/.test(md),
+    });
+  }
+
+  const decisionFiles = fs.existsSync(DECISION_DIR)
+    ? fs.readdirSync(DECISION_DIR).filter((f) => f.endsWith('.md'))
+    : [];
+  const decisionQuestionIds = new Set();
+  for (const f of decisionFiles) {
+    const md = fs.readFileSync(path.join(DECISION_DIR, f), 'utf8');
+    for (const m of md.matchAll(/\bQ-(\d{1,2}[a-z]?)\b/g)) decisionQuestionIds.add(`Q-${m[1]}`);
+  }
+
+  const openItems = items.filter((i) => i.open);
+  return {
+    items,
+    stats: {
+      adrTotal: items.length,
+      adrAccepted: items.length - openItems.length,
+      adrOpen: openItems.length,
+      adrQuestions: items.reduce((a, i) => a + i.questions.length, 0),
+      outOfScope: items.reduce((a, i) => a + i.outOfScope.length, 0),
+      unmeasured: items.reduce((a, i) => a + i.unmeasured.length, 0),
+      decisionQuestions: decisionQuestionIds.size,
+      // Đếm để trang nói được "bao nhiêu thẻ là Critical" mà không tự tính lại.
+      blocking: items.filter((i) => i.blocking).length,
+    },
+  };
+}
+
+/* ------------------------------------------------------------------ ghi ra */
+
+function render({ items, stats }) {
+  const sorted = [...items].sort(
+    (a, b) => (Number(b.open) - Number(a.open)) || (b.weight - a.weight) || a.id.localeCompare(b.id),
+  );
+  return `/**
+ * ⚠️  TỆP SINH TỰ ĐỘNG — ĐỪNG SỬA TAY.
+ *
+ * Sinh bởi \`scripts/extract_work_items.mjs\` từ:
+ *   • \`docs/08-adr/ADR-*.md\`      — trạng thái, §0, Q-ADRNN-x, bảng ngoài phạm vi
+ *   • \`docs/12-decisions/*.md\`    — đếm Q-NN (không trích nội dung)
+ *
+ * Sửa tài liệu rồi chạy:  node scripts/extract_work_items.mjs
+ * CI đỏ nếu tệp này lệch — xem \`scripts/check_work_items_sync.py\`.
+ *
+ * Tệp này KHÔNG chứa issue. Nó chứa **việc còn tồn đọc được từ tài liệu**.
+ * Issue thật nằm trên GitHub và có người chịu trách nhiệm — xem ADR-0044.
+ *
+ * ${stats.adrTotal} ADR · ${stats.adrOpen} còn mở · ${stats.adrQuestions} câu hỏi ADR chưa trả lời ·
+ * ${stats.outOfScope} mục ngoài phạm vi · ${stats.unmeasured} việc đo chưa chạy.
+ */
+export const WORK_ITEMS = ${JSON.stringify(sorted, null, 2)};
+
+export const WORK_STATS = ${JSON.stringify(stats, null, 2)};
+`;
+}
+
+/* --------------------------------------------------------------------- main */
+
+// Chỉ chạy khi gọi trực tiếp. Khi `import` (test, hoặc script khác) thì chỉ lấy
+// hàm ra dùng — nếu không, mỗi lần test import là một lần ghi đè tệp sinh.
+const isMain = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+
+export {
+  collect, render, statusOf, titleOf, questionsOf, outOfScopeOf, isAccepted, shortAnswerOf,
+  priorityOf, deciderOf, dateOf,
+};
+
+if (!isMain) {
+  // Được import: không ghi gì.
+} else {
+const data = collect();
+if (data.items.length === 0) {
+  console.error('❌ không đọc được ADR nào — kiểm lại đường dẫn docs/08-adr');
+  process.exit(1);
+}
+const next = render(data);
+
+if (CHECK) {
+  const prev = fs.existsSync(OUT) ? fs.readFileSync(OUT, 'utf8') : '';
+  if (prev !== next) {
+    console.error('❌ portal/lib/work-items.generated.mjs đã trôi khỏi tài liệu.');
+    console.error('   Chạy: node scripts/extract_work_items.mjs');
+    process.exit(1);
+  }
+  console.log(`✅ work-items.generated.mjs khớp tài liệu (${data.stats.adrTotal} ADR · ${data.stats.adrOpen} mở)`);
+  process.exit(0);
+}
+
+fs.writeFileSync(OUT, next);
+console.log(`đã ghi ${path.relative(ROOT, OUT)}`);
+console.log(`  ${data.stats.adrTotal} ADR · ${data.stats.adrOpen} còn mở · `
+  + `${data.stats.adrQuestions} câu hỏi chưa trả lời · ${data.stats.outOfScope} mục ngoài phạm vi · `
+  + `${data.stats.unmeasured} việc đo chưa chạy`);
+}
