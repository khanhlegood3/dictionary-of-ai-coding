index 0000000..8fe848d
--- /dev/null
+++ b/scripts/check_assets.mjs
@@ -0,0 +1,218 @@
+#!/usr/bin/env node
+/**
+ * check_assets.mjs — mọi tài nguyên HTML trỏ tới phải tải được THẬT.
+ *
+ * ## Vì sao cổng này tồn tại
+ *
+ * Hai lần liên tiếp, production hỏng trong khi toàn bộ cổng local xanh:
+ *
+ * 1. `tasks.html` trỏ `/tasks.css`, nhưng `vercel.json` có rewrite
+ *    `/tasks/:path*` bắt trước ⇒ tài nguyên rơi vào API ⇒ 404 `text/plain`
+ *    ⇒ trang không có CSS.
+ * 2. Trang vẫn trả 200. `curl` và `fetch` chỉ tải **document**, không bao giờ
+ *    tải CSS/JS mà document tham chiếu. Nên "trang trả 200" không nói được gì.
+ *
+ * Bài học: kiểm tài nguyên, không kiểm trang. Và kiểm qua **đúng bộ định tuyến
+ * mà production dùng**, không phải qua `server.mjs` chạy riêng — vì chính
+ * `vercel.json` là thứ đã bắt sai.
+ *
+ * ## Cách kiểm
+ *
+ * 1. Dựng `server.mjs` thật trên một cổng riêng, cơ sở dữ liệu trong bộ nhớ.
+ * 2. Với mỗi trang HTML: tải document qua HTTP, bóc các URL tài nguyên
+ *    (`<link href>`, `<script src>`, `<img src>`, `<link rel=preload>`).
+ *    KHÔNG lấy `<a href>` — đó là điều hướng, không phải tài nguyên.
+ * 3. Tải từng tài nguyên, kiểm 200 + MIME khớp đuôi tệp.
+ * 4. Đối chiếu với `vercel.json`: không tài nguyên nào được nằm dưới một tiền
+ *    tố `rewrite` có `:path*`, trừ khi chính nó khớp một rewrite cụ thể hơn.
+ *
+ * Bước 4 là bước bắt được lỗi 1 ở trên mà không cần deploy.
+ *
+ * Chạy: node scripts/check_assets.mjs
+ */
+
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const ROOT = path.resolve(import.meta.dirname, '..');
+const PORT = 8791;
+const BASE = `http://127.0.0.1:${PORT}`;
+
+let oks = 0;
+const fails = [];
+const ok = (m) => { oks++; };
+const bad = (m) => { fails.push(m); };
+
+/* ------------------------------------------------ 1. khởi động server thật */
+
+const srv = spawn(process.execPath, ['portal/server.mjs'], {
+  cwd: ROOT,
+  env: {
+    ...process.env,
+    PORT: String(PORT),
+    PORTAL_DB: ':memory:',
+    PORTAL_DOSSIER_SEED: '1',
+    PORTAL_ALLOW_DEMO_LOGIN: '1',
+  },
+  stdio: ['ignore', 'pipe', 'pipe'],
+});
+let srvLog = '';
+srv.stdout.on('data', (d) => { srvLog += d; });
+srv.stderr.on('data', (d) => { srvLog += d; });
+
+const stop = () => { try { srv.kill('SIGKILL'); } catch { /* đã chết */ } };
+process.on('exit', stop);
+
+// Chờ cổng mở. Dùng fetch thay vì đọc log để không phụ thuộc chuỗi log.
+let up = false;
+for (let i = 0; i < 100; i++) {
+  try {
+    const r = await fetch(`${BASE}/favicon.ico`);
+    if (r.status) { up = true; break; }
+  } catch { await new Promise((r) => setTimeout(r, 100)); }
+}
+if (!up) {
+  console.log('  ❌ server.mjs không khởi động được');
+  console.log(srvLog.split('\n').slice(-12).join('\n'));
+  process.exit(1);
+}
+
+/* --------------------------------------------------- 2. bóc tài nguyên */
+
+/** Trang HTML cần kiểm, và đường dẫn để tải nó. */
+const PAGES = [
+  { name: 'portal', url: '/portal' },
+  { name: 'tasks', url: '/tasks' },
+  { name: 'play', url: '/play/neon_drift' },
+];
+
+/**
+ * URL tài nguyên trong một document.
+ *
+ * Chỉ lấy phần tử THỰC SỰ nạp tài nguyên. `<a href>` bị loại: một link
+ * điều hướng tới `/portal` nằm dưới `/portal/:path*` sẽ tạo dương tính giả —
+ * đã mắc đúng lỗi này khi viết `check_tasks_page.mjs`.
+ *
+ * Bỏ qua `data:` (favicon nhúng) và URL tuyệt đối ra ngoài (không thuộc repo).
+ */
+function assetUrls(html) {
+  const out = new Set();
+  const re = /<(?:link|script|img)\b[^>]*>/gi;
+  for (const m of html.matchAll(re)) {
+    const tag = m[0];
+    const attr = /\b(?:href|src)="([^"]+)"/i.exec(tag);
+    if (!attr) continue;
+    const url = attr[1];
+    if (/^(?:data:|https?:|\/\/|#)/i.test(url)) continue;
+    out.add(url.startsWith('/') ? url : `/assets/${url.replace(/^\.\//, '')}`);
+  }
+  return [...out];
+}
+
+/** MIME mong đợi theo đuôi tệp. */
+const MIME = {
+  '.css': /^text\/css/,
+  '.js': /javascript/,
+  '.mjs': /javascript/,
+  '.html': /text\/html/,
+  '.svg': /image\/svg/,
+  '.png': /image\/png/,
+  '.ico': /image\//,
+};
+
+for (const page of PAGES) {
+  const res = await fetch(BASE + page.url);
+  if (!res.ok) { bad(`${page.name}: ${page.url} trả ${res.status}`); continue; }
+  ok(`${page.name}: ${page.url} → 200`);
+
+  const html = await res.text();
+  const urls = assetUrls(html);
+  if (!urls.length) { bad(`${page.name}: không tìm thấy tài nguyên nào — bộ bóc có thể đã hỏng`); continue; }
+  ok(`${page.name}: ${urls.length} tài nguyên`);
+
+  for (const url of urls) {
+    const r = await fetch(BASE + url);
+    if (!r.ok) {
+      bad(`${page.name}: ${url} → ${r.status} (tài nguyên không tải được ⇒ trang sẽ hỏng giao diện)`);
+      continue;
+    }
+    const ct = (r.headers.get('content-type') || '').split(';')[0].trim();
+    const ext = path.extname(new URL(url, BASE).pathname);
+    const want = MIME[ext];
+    if (want && !want.test(ct)) {
+      bad(`${page.name}: ${url} → MIME ${ct} nhưng đuôi ${ext} cần ${want}`);
+      continue;
+    }
+    const body = await r.text();
+    if (body.trim().length < 20) {
+      bad(`${page.name}: ${url} → 200 nhưng thân rỗng (${body.length} byte)`);
+      continue;
+    }
+    ok(`${page.name}: ${url} → 200 ${ct}`);
+  }
+}
+
+/* ------------------------------------- 3. tài nguyên phải nằm dưới /assets/ */
+
+/*
+ * BẤT BIẾN: mọi tài nguyên của trang phải nằm dưới `/assets/`.
+ *
+ * Đây là quy tắc thiết kế, không phải mô phỏng Vercel — và tôi đã thử mô phỏng
+ * trước, rồi bỏ, vì lý do đáng ghi lại: bộ khớp `:path*` của Vercel không dễ
+ * suy ra bằng regex, nên một bản mô phỏng viết tay sẽ vừa bỏ sót lỗi thật vừa
+ * báo nhầm. Chứng minh đỏ ĐẦU TIÊN của tôi dựng lại đúng bug cũ và cổng vẫn
+ * xanh — tức phần mô phỏng đó vô dụng. Thà một quy tắc thô mà đúng còn hơn
+ * một bản mô phỏng trông thông minh mà không bắt được gì.
+ *
+ * Vì sao quy tắc này là đủ: mỗi `rewrite` trong `vercel.json` đều trỏ vào
+ * `api/portal`, và mọi route ở đó là một đoạn. Một tài nguyên đặt cùng tiền tố
+ * với một trang (`/tasks.css` cạnh `/tasks`) chỉ cần trang đó mọc thêm một
+ * `rewrite` dạng `/tasks/:path*` là bị nuốt — đã xảy ra thật, và local KHÔNG
+ * thấy vì `server.mjs` phục vụ tài nguyên bằng route riêng. Đặt tài nguyên
+ * dưới `/assets/` thì không tiền tố trang nào chạm tới.
+ */
+const vercel = JSON.parse(fs.readFileSync(path.join(ROOT, 'vercel.json'), 'utf8'));
+const rewrites = (vercel.rewrites || []).map((r) => r.source);
+
+/** Tiền tố literal của một rewrite: phần văn bản trước `:token` đầu tiên. */
+function prefixOf(src) {
+  const i = src.indexOf('/:');
+  return i === -1 ? src : src.slice(0, i);
+}
+
+const pagePrefixes = rewrites
+  .map((src) => ({ src, prefix: prefixOf(src) }))
+  .filter(({ prefix }) => prefix && prefix !== '/assets');
+
+const allAssets = new Set();
+for (const page of PAGES) {
+  try {
+    const html = await (await fetch(BASE + page.url)).text();
+    for (const u of assetUrls(html)) allAssets.add(u);
+  } catch { /* trang đã báo lỗi ở trên */ }
+}
+
+for (const url of allAssets) {
+  const clash = pagePrefixes.filter(({ prefix }) => url === prefix || url.startsWith(`${prefix}/`)
+    || url.startsWith(`${prefix}.`));
+  if (url.startsWith('/assets/')) {
+    ok(`${url} nằm dưới /assets/ — không tiền tố trang nào chạm tới`);
+  } else if (clash.length) {
+    bad(`${url} nằm dưới tiền tố trang ${clash.map((c) => `\`${c.src}\``).join(', ')} `
+      + '⇒ nếu trang đó có (hoặc sau này thêm) một rewrite `:path*`, tài nguyên sẽ bị nuốt và 404 trên production. '
+      + 'Chuyển tài nguyên vào /assets/.');
+  } else {
+    bad(`${url} không nằm dưới /assets/ — quy ước của repo là mọi tài nguyên trang ở /assets/`);
+  }
+}
+
+/* ------------------------------------------------------------------ kết */
+
+stop();
+if (fails.length) {
+  for (const f of fails) console.log(`  ❌ ${f}`);
+  console.log(`\n## ❌ ${fails.length}/${oks + fails.length} kiểm tra THẤT BẠI — tài nguyên trang không tải được`);
+  process.exit(1);
+}
+console.log(`## ✅ ${oks}/${oks} kiểm tra đạt — mọi tài nguyên HTML trỏ tới đều tải được, đúng MIME, không bị rewrite nuốt`);
