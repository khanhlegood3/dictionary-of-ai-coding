+ * Nên thay vì thêm một bộ kiểm quét mọi `<a href>` (sẽ báo nhầm các link
+ * GitHub ngoài miền), ba nút này chuyển sang `href="#view-…"`, và
+ * `check_hero_links` dưới đây khẳng định MỌI anchor trong `.hero-actions` đều
+ * trỏ tới một `section.view` CÓ THẬT trong chính document này. Như vậy không
+ * cần đoán route nào tồn tại: nếu đích không có trong DOM thì đó là lỗi.
+ */
+function wireHeroLinks() {
+  $$('.hero-actions a[href^="#view-"]').forEach((a) => {
+    a.addEventListener('click', (e) => {
+      const id = a.getAttribute('href').slice(1);
+      if (!document.getElementById(id)) return;   // để trình duyệt xử lý, đừng chặn
+      e.preventDefault();
+      showView(id.replace(/^view-/, ''));
+    });
+  });
+}
+
