@@ -0,0 +1,184 @@
+#!/usr/bin/env node
+/**
+ * check_hidden_attr.mjs — thuộc tính `hidden` có thật sự ẨN không.
+ *
+ * ## Lỗi đã mắc (ảnh Console 2026-11-24)
+ *
+ * Trang `/tasks`: bấm nút ✕ để đóng drawer, không đóng được. `el.hidden = true`
+ * chạy đúng, `aria-hidden` đổi đúng, test jsdom xanh — nhưng màn hình không đổi.
+ *
+ * Nguyên nhân: `hidden` trong HTML chỉ là `display: none` của **user-agent**.
+ * `.tw-drawer { display: flex }` là khai báo của **tác giả**, và theo cascade
+ * khai báo của tác giả thắng user-agent — bất kể thứ tự trong tệp. Nên
+ * `display: flex` luôn thắng `hidden`, và thuộc tính thành vô nghĩa.
+ *
+ * Cùng lỗi xuất hiện lần hai ở `portal/public/app.css`: `#oq-count` là `.badge`
+ * có `display: inline-flex`, nên `badge.hidden = true` không ẩn được huy hiệu.
+ *
+ * ## Cách kiểm — truy vết, không đoán theo tệp
+ *
+ * Không đủ nếu chỉ hỏi "tệp này có class `display` không": `play.css` có 7 class
+ * `display` nhưng `play-badge` không nằm trong số đó, nên `play.js` đặt
+ * `badge.hidden = true` vẫn chạy đúng. Phải truy từng chỗ gán `hidden` tới phần
+ * tử thật:
+ *
+ *   biến JS  ──`$('x')`──▶  id  ──HTML──▶  class  ──CSS──▶  `display`
+ *
+ * Chỉ khi chuỗi đó dẫn tới một class có `display` thì mới là lỗi thật.
+ *
+ * ## Rule nào đủ để cứu
+ *
+ * - `[hidden] { display: none !important }` — đủ cho mọi phần tử.
+ * - `.cls[hidden] { display: none }` — đủ cho `.cls`, vì `.cls[hidden]`
+ *   (0,2,0) đặc hiệu hơn `.cls` (0,1,0) nên thắng mà không cần `!important`.
+ * - `.cls[hidden] { display: none }` **không** cứu phần tử khác `.cls`.
+ * - `[hidden] { display: none }` **không** `!important` — KHÔNG đủ: nó (0,1,0)
+ *   hoà với `.cls` (0,1,0) và thua theo thứ tự khai báo.
+ *
+ * Chạy: node scripts/check_hidden_attr.mjs
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+const ROOT = path.resolve(import.meta.dirname, '..');
+
+/** Cặp CSS ↔ JS ↔ HTML của portal. Thêm màn hình mới thì thêm vào đây. */
+const PAIRS = [
+  { css: 'portal/public/app.css', js: 'portal/public/app.js', html: 'portal/public/index.html' },
+  { css: 'portal/public/tasks.css', js: 'portal/public/tasks.js', html: 'portal/public/tasks.html' },
+  { css: 'portal/public/dossier.css', js: 'portal/public/dossier.js', html: 'portal/public/dossier.html' },
+  { css: 'portal/public/play.css', js: 'portal/public/play.js', html: 'portal/public/play.html' },
+];
+
+const fails = [];
+let oks = 0;
+const ok = (m) => { oks++; if (process.env.VERBOSE) console.log(`  · ${m}`); };
+const bad = (m) => { fails.push(m); };
+
+/** Bóc chú thích — không bóc thì selector dính nguyên khối chú thích phía trước. */
+const stripComments = (css) => css.replace(/\/\*[\s\S]*?\*\//g, '');
+
+/** class → giá trị `display` (bỏ qua `none`). */
+function classesWithDisplay(css) {
+  const out = new Map();
+  for (const m of stripComments(css).matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+    const d = m[2].match(/display\s*:\s*([a-z-]+)/);
+    if (!d || d[1] === 'none') continue;
+    for (const sel of m[1].split(',')) {
+      const mm = sel.trim().match(/^\.([\w-]+)$/);
+      if (mm) out.set(mm[1], d[1]);
+    }
+  }
+  return out;
+}
+
+/**
+ * Tập "cứu" — các selector `…[hidden]` có `display: none`, kèm cờ `important`.
+ * Trả về `{ global, byClass }`.
+ */
+function hiddenGuards(css) {
+  const global = { present: false, important: false };
+  const byClass = new Set();
+  for (const m of stripComments(css).matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
+    if (!/display\s*:\s*none/.test(m[2])) continue;
+    const important = /display\s*:\s*none\s*!important/.test(m[2]);
+    for (const raw of m[1].split(',')) {
+      const sel = raw.trim();
+      if (sel === '[hidden]') {
+        global.present = true;
+        global.important = global.important || important;
+        continue;
+      }
+      const mm = sel.match(/^\.([\w-]+)\[hidden\]$/);
+      if (mm) byClass.add(mm[1]);
+    }
+  }
+  return { global, byClass };
+}
+
+/** id → Set(class) từ HTML. */
+function idToClasses(html) {
+  const out = new Map();
+  for (const m of html.matchAll(/<[^>]*>/g)) {
+    const tag = m[0];
+    const id = tag.match(/\bid="([^"]+)"/);
+    if (!id) continue;
+    const cls = tag.match(/\bclass="([^"]*)"/);
+    out.set(id[1], new Set(cls ? cls[1].split(/\s+/).filter(Boolean) : []));
+  }
+  return out;
+}
+
+/**
+ * biến JS → id, từ `const x = $('id')`, `const x = $('#id')`,
+ * `document.getElementById('id')`. Chỉ theo mẫu gán trực tiếp.
+ */
+function varToId(js) {
+  const out = new Map();
+  const re = /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:\$\(\s*'#?([\w-]+)'\s*\)|document\.getElementById\(\s*'([\w-]+)'\s*\))/g;
+  for (const m of js.matchAll(re)) out.set(m[1], m[2] || m[3]);
+  return out;
+}
+
+let conflicts = 0;
+
+for (const { css, js, html } of PAIRS) {
+  const p = (f) => path.join(ROOT, f);
+  if (!fs.existsSync(p(css))) continue;
+  const cssText = fs.readFileSync(p(css), 'utf8');
+  const jsText = fs.existsSync(p(js)) ? fs.readFileSync(p(js), 'utf8') : '';
+  const htmlText = fs.existsSync(p(html)) ? fs.readFileSync(p(html), 'utf8') : '';
+
+  const displays = classesWithDisplay(cssText);
+  const guard = hiddenGuards(cssText);
+  const ids = idToClasses(htmlText);
+  const vars = varToId(jsText);
+
+  // (1) Từng chỗ JS gán `.hidden = …` trên một biến đã truy được về id.
+  for (const m of jsText.matchAll(/([A-Za-z_$][\w$]*)\s*\.\s*hidden\s*=/g)) {
+    const v = m[1];
+    const id = vars.get(v);
+    if (!id) { ok(`${js}: \`${v}.hidden\` — biến chưa truy được về id, bỏ qua`); continue; }
+    const classes = ids.get(id) || new Set();
+    const risky = [...classes].filter((c) => displays.has(c));
+    if (!risky.length) { ok(`${js}: \`${v}\` → #${id} không class nào đặt \`display\` — an toàn`); continue; }
+
+    conflicts++;
+    const saved = guard.global.important || risky.every((c) => guard.byClass.has(c));
+    if (saved) {
+      ok(`${js}: \`${v}\` → #${id} (${risky.map((c) => `.${c}: ${displays.get(c)}`).join(', ')}) — đã có rule cứu`);
+    } else {
+      const why = guard.global.present && !guard.global.important
+        ? '`[hidden]` có nhưng THIẾU `!important` nên hoà đặc hiệu với class và thua theo thứ tự'
+        : 'không có rule `[hidden]` nào cứu class này';
+      bad(`${js}: \`${v}.hidden = …\` sẽ KHÔNG ẩn được #${id} — `
+        + `${risky.map((c) => `.${c} { display: ${displays.get(c)} }`).join(', ')} `
+        + `đè lên \`hidden\` của user-agent; ${why}`);
+    }
+  }
+
+  // (2) Phần tử trong HTML có thuộc tính `hidden` mà class đặt `display`.
+  for (const m of htmlText.matchAll(/<[^>]*>/g)) {
+    const tag = m[0];
+    if (!/\shidden(?=[\s/>])/.test(tag)) continue;
+    const cls = tag.match(/\bclass="([^"]*)"/);
+    if (!cls) continue;
+    const risky = cls[1].split(/\s+/).filter((c) => displays.has(c));
+    if (!risky.length) continue;
+    conflicts++;
+    const saved = guard.global.important || risky.every((c) => guard.byClass.has(c));
+    if (!saved) {
+      bad(`${html}: phần tử class="${cls[1]}" khai báo \`hidden\` ngay trong HTML nhưng `
+        + `${risky.map((c) => `.${c} { display: ${displays.get(c)} }`).join(', ')} đè lên nó`);
+    } else ok(`${html}: phần tử class="${cls[1]}" có guard`);
+  }
+}
+
+console.log(`\n${conflicts} chỗ \`hidden\` tiếp xúc với class có \`display\`; ${oks} chỗ an toàn.`);
+if (fails.length) {
+  for (const f of fails) console.log(`  ❌ ${f}`);
+  console.log(`\n## ❌ ${fails.length} lỗi — thuộc tính \`hidden\` KHÔNG ẩn được`);
+  process.exit(1);
+}
+console.log('## ✅ tất cả chỗ dùng `hidden` đều thật sự ẩn');
